---
import SiteLayout from '../layouts/SiteLayout.astro';
import OriginalIndex from '../components/OriginalIndex.astro';
import { href } from '../lib/constants.mjs';
import site from '../data/site.json';

const founders = site.founders.filter(f => f && f.name);

const indexEntries = [
  { id: 'michael', label: 'Michael', description: 'Founder of Nora SuperIntelligence Lab' },
  { id: 'expertise', label: 'Expertise', description: 'Focus areas from the public profile' },
  { id: 'technologies', label: 'Skills', description: 'Technologies and tools' },
  { id: 'opportunities', label: 'Opportunities', description: 'Roles and projects in scope' },
  { id: 'contact', label: 'Contact', description: 'Email, GitHub and LinkedIn' }
];
---
<SiteLayout title="Founders — Nora SuperIntelligence Lab" description="The people behind Nora SuperIntelligence Lab." path="/founders/" customIndex={true}>
  <section class="hero" id="overview">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--one" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--two" aria-hidden="true"></div>
    <div class="shell hero-layout">
      <div class="hero-copy">
        <h1>The person behind the lab.</h1>
        <p class="hero-lede">Building Nora SuperIntelligence Lab.</p>
        {site.contact && (
          <div class="hero-actions">
            <a class="button button--primary" href={site.contact.links[0].url}>{site.contact.links[0].label} <span aria-hidden="true">→</span></a>
            <a class="button button--ghost" href={href('/architecture/')}>Read the architecture</a>
          </div>
        )}
      </div>
      <OriginalIndex tagline="Nora SuperIntelligence Lab" title="Founders" entries={indexEntries} ariaLabel="Founders navigation" />
    </div>
  </section>

  {founders.map((f, i) => (
    <section class="section workflow-section founders-section founder-profile" id={i === 0 ? 'michael' : f.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')} data-index-label={f.name}>
      <div class="shell">
        <div class="section-heading section-heading--split">
          <div>
            <p class="section-label">Founder {String(i + 1).padStart(2, '0')}</p>
            <h2>{f.name}</h2>
          </div>
          <p>{f.profileRole || f.role}</p>
        </div>
        <div class="founder-layout">
          {f.image && <img class="founder-portrait" src={href('/' + f.image)} alt={`Portrait of ${f.name}`} width="200" height="200" />}
          <div class="founder-main">
            <p class="founder-bio">{f.bio}</p>
            {f.background && <p class="founder-bio">{f.background}</p>}

            {i === 0 && (f.outcomes || f.expertise || f.skillGroups) && (
              <div class="founder-expertise" id="expertise" data-index-label="Expertise">

                {f.outcomes && f.outcomes.length > 0 && (
                  <>
                    <h3 class="founder-subheading">Selected engineering outcomes.</h3>
                    <ul class="founder-outcomes" aria-label={`${f.name} selected engineering outcomes`}>
                      {f.outcomes.map(item => <li>{item}</li>)}
                    </ul>
                  </>
                )}

                {f.expertise && f.expertise.length > 0 && (
                  <>
                    <h3 class="founder-subheading">Core areas of expertise.</h3>
                    <div class="founder-core-list">
                      {f.expertise.map(area => (
                        <article class="founder-core-item">
                          <h4>{area.title}</h4>
                          <p>{area.body}</p>
                        </article>
                      ))}
                    </div>
                  </>
                )}

                {f.skillGroups && f.skillGroups.length > 0 && (
                  <div class="founder-technologies" id="technologies" data-index-label="Skills">
                    <h3 class="founder-subheading">Technologies and tools.</h3>
                    {f.skillsIntro && <p class="founder-skills-intro">{f.skillsIntro}</p>}
                    <div class="founder-skills-table">
                      {f.skillGroups.map(group => (
                        <details class="founder-skill-row">
                          <summary class="founder-skill-summary">
                            <span class="founder-skill-title">{group.title}</span>
                          </summary>
                          <p class="founder-skill-body">{group.body}</p>
                        </details>
                      ))}
                    </div>
                  </div>
                )}

                <div class="founder-evidence" aria-labelledby="nora-examples-heading">
                  <h3 class="founder-subheading" id="nora-examples-heading">Current knowledge-assistant examples.</h3>
                  <div class="founder-evidence-list">
                    <article class="founder-evidence-item">
                      <p class="evidence-type">Decision · request boundary</p>
                      <h4>Keep each request inspectable and bounded.</h4>
                      <p>The accepted contract limits a turn to three retrieval calls and four logical model calls, with bounded provider retries and one no-tool repair within that allowance.</p>
                      <a class="text-link" href={href('/decisions/#approach-and-tradeoffs')}>Read the request bounds <span aria-hidden="true">→</span></a>
                    </article>
                    <article class="founder-evidence-item">
                      <p class="evidence-type">Decision · service boundary</p>
                      <h4>Keep retrieval separate from knowledge preparation.</h4>
                      <p>Retrieval remains a separate service while conversion, deterministic preparation, embedding, import, and activation stay operator-triggered and outside conversations.</p>
                      <a class="text-link" href={href('/architecture/#manual-ingestion')}>See the manual-ingestion boundary <span aria-hidden="true">→</span></a>
                    </article>
                    <article class="founder-evidence-item">
                      <p class="evidence-type">Tested outcome</p>
                      <h4>Check conversation state across restart.</h4>
                      <p>An isolated ARM Linux Compose check preserved existing message IDs after PostgreSQL and Coordination restart; a custom-format dump restored the same four messages.</p>
                      <a class="text-link" href={href('/validation/#isolated-container-checks')}>Read the validation row <span aria-hidden="true">→</span></a>
                    </article>
                  </div>
                </div>
              </div>
            )}

            {i !== 0 && f.focus && f.focus.length > 0 && (
              <div class="founder-expertise" id="expertise" data-index-label="Expertise">
                <h3 class="founder-subheading">Focus areas.</h3>
                <ul class="hero-signals founder-focus" aria-label={`${f.name} focus areas`}>
                  {f.focus.map(item => <li>{item}</li>)}
                </ul>
              </div>
            )}

          </div>
        </div>
      </div>
    </section>
  ))}

  {site.contact && (
    <section class="section workflow-section founders-section pilots-section founder-closing" id="opportunities" data-index-label="Opportunities">
      <div class="shell">
        <div class="section-heading section-heading--split">
          <div>
            <p class="section-label">Opportunities</p>
            <h2>{site.contact.heading}</h2>
          </div>
          <p>{site.contact.body}</p>
        </div>
        <p>I offer readiness assessments, architecture reviews and scoped prototypes for knowledge assistants, workflow automation and research support. My engineering work also covers data platforms, real-time streaming, healthcare ingestion, data quality and reliability.</p>
        <div class="founder-contact" id="contact" data-index-label="Contact">
          <h3 class="founder-subheading">Contact Michael.</h3>
          <div class="founder-contact-group">
            {founders.map(f => (
              f.links && f.links.map(l => <a class="text-link" href={l.url}>{l.label}</a>)
            ))}
          </div>
        </div>
      </div>
    </section>
  )}
</SiteLayout>
<style>
/* Scoped compaction for the Founders page only; original section spacing lives in original.css. */
.founders-section {
  scroll-margin-top: calc(var(--header-height) + 24px);
}
@media (min-width: 1081px) {
  .founders-section {
    padding-top: 72px;
    padding-bottom: 72px;
  }
}
@media (max-width: 1080px) {
  .founders-section {
    padding-top: 48px;
    padding-bottom: 48px;
  }
}
.founder-layout {
  display: flex;
  align-items: flex-start;
  gap: 48px;
  margin-top: 8px;
}
.founder-portrait {
  width: 200px;
  height: 200px;
  max-width: 42vw;
  flex: 0 0 auto;
  object-fit: cover;
  border-radius: var(--radius-md);
  border: 3px solid rgba(255, 255, 255, 0.16);
}
.founder-main {
  min-width: 0;
}
.founder-bio {
  color: var(--ink-soft);
  max-width: 66ch;
}
.founder-subheading {
  font-size: 1.15rem;
  margin: 1.6em 0 0.5em;
  color: var(--ink);
}
.founder-expertise {
  scroll-margin-top: calc(var(--header-height) + 24px);
}
.founder-outcomes {
  list-style: disc;
  padding-left: 1.25rem;
  margin: 12px 0 0;
  max-width: 66ch;
}
.founder-outcomes li {
  margin: 10px 0;
  color: var(--ink-soft);
  font-size: 15px;
  line-height: 1.5;
}
.founder-core-list {
  margin-top: 12px;
}
.founder-core-item h4 {
  font-size: 18px;
  line-height: 1.3;
  margin: 1.4em 0 0.4em;
  color: var(--ink);
}
.founder-core-item p {
  font-size: 15px;
  line-height: 1.5;
  margin: 0 0 1em;
  color: var(--ink-soft);
  max-width: 66ch;
}
.founder-technologies {
  scroll-margin-top: calc(var(--header-height) + 24px);
  margin-top: 42px;
}
.founder-skills-intro {
  font-size: 15px;
  line-height: 1.5;
  margin: 0 0 16px;
  color: var(--ink-soft);
  max-width: 66ch;
}
.founder-skills-table {
  border-collapse: collapse;
  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
  border-right: 1px solid var(--line);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.founder-skill-row {
  border-bottom: 1px solid var(--line);
}
.founder-skill-summary {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 10px 16px;
  cursor: pointer;
  list-style: none;
  font-size: 15px;
  line-height: 1.4;
  color: var(--ink);
  background: transparent;
  transition: background-color 0.15s ease;
}
.founder-skill-summary::-webkit-details-marker {
  display: none;
}
.founder-skill-summary::marker {
  content: '';
}
.founder-skill-summary:hover {
  background: rgba(255, 255, 255, 0.03);
}
.founder-skill-summary:focus-visible {
  outline: 2px solid var(--teal);
  outline-offset: -2px;
  background: rgba(45, 212, 191, 0.05);
}
.founder-skill-title::before {
  content: '+';
  margin-right: 12px;
  color: var(--teal);
  font-weight: 700;
  font-size: 16px;
  flex-shrink: 0;
}
.founder-skill-row[open] .founder-skill-title::before {
  content: '−';
}
.founder-skill-body {
  font-size: 15px;
  line-height: 1.5;
  margin: 0;
  padding: 4px 16px 16px 38px;
  color: var(--ink-soft);
  max-width: 66ch;
  word-break: break-word;
}
.founder-focus {
  margin-top: 12px;
}
.founder-evidence {
  margin-top: 42px;
}
.founder-evidence-list {
  display: grid;
  gap: 0;
  border-top: 1px solid var(--line);
}
.founder-evidence-item {
  padding: 24px 0 26px;
  border-bottom: 1px solid var(--line);
}
.evidence-type {
  margin-bottom: 8px;
  color: var(--teal);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}
.founder-evidence-item h4 {
  margin: 0 0 10px;
  color: var(--ink);
  font-size: 1.05rem;
  line-height: 1.25;
}
.founder-evidence-item > p:not(.evidence-type) {
  max-width: 66ch;
  margin-bottom: 14px;
  color: var(--ink-soft);
}
.founder-evidence-item .text-link {
  font-size: 0.9rem;
}
.founder-contact {
  margin-top: 24px;
  scroll-margin-top: calc(var(--header-height) + 24px);
}
.founder-contact-note {
  color: var(--ink-soft);
  max-width: 66ch;
  margin: 0 0 16px;
}
.founder-contact-group {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 18px;
}
.founder-contact-group a {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding-block: 6px;
}
@media (max-width: 720px) {
  .founder-layout {
    flex-direction: column;
    gap: 24px;
  }
  .founder-portrait {
    width: 168px;
    height: 168px;
    max-width: 60vw;
  }
}
</style>
