---
import SiteLayout from '../layouts/SiteLayout.astro';
import OriginalIndex from '../components/OriginalIndex.astro';
import { Content, frontmatter } from '../content/motivation.md';

const { title, opening } = frontmatter;
const description = 'The design choices behind the Nora Harness, from retained knowledge and conversation state to model routing and artifact review.';
const indexEntries = [
  { id: 'private-knowledge-backbone', label: 'Knowledge Backbone', description: 'Keep sources useful across conversations' },
  { id: 'conversation-continuity', label: 'Conversation continuity', description: 'Return to the evidence and the thread' },
  { id: 'workflow-composition', label: 'Workflow composition', description: 'Give each step a clear job and handoff' },
  { id: 'model-routing-for-quality-cost-and-latency', label: 'Model routing', description: 'Compare quality, cost, and latency' },
  { id: 'one-coordination-layer', label: 'Coordination Layer', description: 'Connect clients to the same workflow' },
  { id: 'evaluation-and-revision', label: 'Evaluation and revision', description: 'Carry review findings into the next draft' },
  { id: 'learning-from-failures', label: 'Learning loops', description: 'Use failures to improve the system' }
];
---
<SiteLayout title={`${title} — Nora SuperIntelligence Lab`} description={description} path="/motivation/" customIndex={true}>
  <section class="hero" aria-labelledby="motivation">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--one" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--two" aria-hidden="true"></div>
    <div class="shell hero-layout">
      <div class="hero-copy">
        <h1 id="motivation">{title}</h1>
        <p class="hero-lede">{opening}</p>
      </div>
      <OriginalIndex tagline="Motivation" entries={indexEntries} ariaLabel="Motivation navigation" />
    </div>
  </section>
  <article class="motivation" aria-label="Seven design motivations">
    <Content />
  </article>
</SiteLayout>

<style>
  .motivation {
    min-inline-size: 0;
  }
  .motivation :global(.section) {
    padding-block: 80px;
  }
  .motivation :global(.section-heading) {
    margin-block-end: 32px;
  }
  .motivation :global(.motivation-prose) {
    max-inline-size: 66ch;
    color: var(--ink-soft);
    font-size: 18px;
    line-height: 1.7;
  }
  .motivation :global(.motivation-prose li + li) { margin-block-start: 16px; }
  .motivation :global(.motivation-prose strong) { color: var(--ink); }
  @media (min-width: 1081px) and (max-width: 1599px) {
    :global(html.has-docked-orchestration) .motivation :global(.section > .shell) {
      padding-right: 240px;
    }
  }
  h1 { text-wrap: balance; }
  .motivation :global(.motivation-next) { border-block-start: 1px solid var(--line); margin-block-start: 40px; padding-block-start: 16px; }
  .motivation :global(.motivation-next a) { display: inline-flex; align-items: center; gap: .5em; min-block-size: 44px; }
  .motivation :global(.motivation-next-primary) { font-weight: 700; }
  .motivation :global(.motivation-next-secondary) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    font-size: 1rem;
  }

  @media (max-width: 860px) {
    .motivation :global(.section) { padding-block: 56px; }
    .motivation :global(.section-heading) { margin-block-end: 24px; }
    .motivation :global(.section-heading--split) { gap: 16px; }
    .motivation :global(.section-heading h2) { margin-block-end: 8px; }
    .motivation :global(.section-heading--split > p) { margin-block-end: 0; }
  }

  .motivation :global(.briefing-diagram) {
    container: briefing / inline-size;
    max-inline-size: 66ch;
    margin: 28px 0;
    scroll-margin-block-start: calc(var(--header-height) + 24px);
    font-size: 18px;
  }
  .motivation :global(.briefing-canvas) {
    padding: 24px;
    border: 1px solid #d2ddea;
    border-radius: var(--radius-sm);
    background: #fff;
    color: #182d48;
    font-size: 1rem;
    line-height: 1.5;
  }
  .motivation :global(.briefing-flow) { --flow-accent: #275e91; }
  .motivation :global(.briefing-lane-label) {
    color: var(--flow-accent);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-block-end: 8px;
  }
  .motivation :global(.briefing-flow > strong) {
    display: block;
    margin-block-end: 20px;
    color: #182d48;
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .motivation :global(.briefing-flow--comparison) {
    --flow-accent: #7862c4;
    margin-block-start: 20px;
  }
  .motivation :global(.briefing-flow ol) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: briefing-stage;
  }
  .motivation :global(.briefing-flow li) {
    position: relative;
    min-inline-size: 0;
    margin: 0;
    padding: 16px;
    border: 1px solid #d2ddea;
    border: 1px solid var(--flow-accent);
    border-radius: var(--radius-sm);
    background: #eff6ff;
    counter-increment: briefing-stage;
  }
  .motivation :global(.briefing-flow li::before) {
    content: counter(briefing-stage, decimal-leading-zero);
    display: block;
    margin-block-end: 12px;
    color: var(--flow-accent);
    font-size: .75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .motivation :global(.briefing-flow li b) { display: block; line-height: 1.4; }
  .motivation :global(.briefing-flow li > span) {
    display: block;
    margin-block-start: 8px;
    color: #435672;
    font-size: .875rem;
  }
  .motivation :global(.briefing-arrow) {
    position: absolute;
    inline-size: 24px;
    block-size: 24px;
    inset-block-start: 50%;
    inset-inline-start: calc(100% + 3px);
    transform: translateY(-50%);
    fill: none;
    stroke: var(--flow-accent);
    stroke-width: 1.5;
  }
  .motivation :global(.briefing-handoff) { margin: 24px 0 0; padding: 16px 0 0; border-top: 1px solid #d2ddea; color: #435672; font-size: .875rem; line-height: 1.5; }
  .motivation :global(.briefing-flow--comparison li) { background: #f3efff; }
  .motivation :global(.briefing-feedback) { margin-top: 24px; padding: 20px; border: 1px solid #8773b4; border-radius: 8px; background: #f7f4ff; color: #182d48; }
  .motivation :global(.briefing-feedback-bridge) { color: #584391; font-size: .875rem; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #dcd3ef; }
  .motivation :global(.briefing-feedback .briefing-lane-label) { color: #584391; }
  .motivation :global(.briefing-feedback > strong) { font-size: 1.125rem; }
  .motivation :global(.briefing-feedback p) { font-size: .875rem; color: #435672; margin: 10px 0 0; line-height: 1.5; }
  .motivation :global(.briefing-criteria) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 18px 0; }
  .motivation :global(.briefing-criteria dt) { font-weight: 700; color: #584391; font-size: .875rem; }
  .motivation :global(.briefing-criteria dd) { margin: 6px 0 0; font-size: .875rem; line-height: 1.5; color: #435672; }
  .motivation :global(.briefing-return) { border-top: 1px solid #dcd3ef; padding-top: 14px; }
  @container briefing (inline-size < 34rem) {
    .motivation :global(.briefing-criteria) { grid-template-columns: 1fr; gap: 12px; }
    .motivation :global(.briefing-criteria > div) { display: grid; grid-template-columns: 60px 1fr; gap: 12px; }
    .motivation :global(.briefing-criteria dd) { margin: 0; }
    .motivation :global(.briefing-feedback) { padding: 16px; }
    .motivation :global(.briefing-flow li::before) { position: absolute; inset-inline-start: 12px; inset-block-start: 12px; }
    .motivation :global(.briefing-flow li) { padding: 12px 12px 12px 42px; }
  }
  .motivation :global(.briefing-diagram figcaption) {
    margin-block-end: 12px;
    color: var(--ink-soft);
    font-size: .9375rem;
    line-height: 1.6;
  }
  @container briefing (inline-size < 34rem) {
    .motivation :global(.briefing-flow ol) {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .motivation :global(.briefing-canvas) { padding: 20px 16px; }
    .motivation :global(.briefing-arrow) {
      inset-block-start: calc(100% + 3px);
      inset-inline-start: 50%;
      transform: translateX(-50%) rotate(90deg);
    }
  }
</style>
