---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIndex from '../components/PageIndex.astro';
import { Content } from '../content/validation.md';
---
<SiteLayout title="Validation — Nora SuperIntelligence Lab" description="Validation steps and verification for the Nora intelligence system architecture." path="/validation/">
  <article class="container content-page" data-supporting-page="validation">
    <h1 id="validation">Validation</h1>
    <p class="page-intro" id="purpose">Dated synthetic tests, bounded real model checks, and deployment proofs are recorded separately. Source implementation does not by itself prove a live rollout or general reliability.</p>
    <PageIndex />
    <Content />
  </article>
</SiteLayout>
<style>
.content-page { padding-top: 40px; padding-bottom: 40px; }
.content-page :global(p) { font-size: 18px; line-height: 1.7; max-width: 66ch; }
.content-page :global(h2) { margin-top: 2.5em; }
.content-page .page-intro { scroll-margin-top: calc(var(--header-height) + 24px); font-size: 18px; line-height: 1.7; max-width: 66ch; color: var(--ink-soft); }
</style>
