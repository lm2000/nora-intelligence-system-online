---
import SiteLayout from '../layouts/SiteLayout.astro';
import Diagram from '../components/Diagram.astro';
import SourceMap from '../components/SourceMap.astro';
---
<SiteLayout title="Walkthroughs — Nora SuperIntelligence Lab" description="A fictional Atlas example walkthrough for request handling and manual ingestion in Nora SuperIntelligence Lab's knowledge assistant." path="/walkthroughs/" customIndex={true}>
  <div class="container walkthroughs-page" data-walkthroughs>
    <h1>Walkthroughs</h1>
    <p class="page-intro">Architecture explains the reusable system. These walkthroughs apply it to a fictional Atlas request and a separate operator-triggered knowledge update.</p>

    <div class="tabs" id="walkthrough-flows" role="tablist" aria-label="Walkthrough flow">
      <button role="tab" id="tab-request" aria-controls="panel-request" aria-selected="true" tabindex="0" data-flow-tab="request">Atlas request</button>
      <button role="tab" id="tab-ingestion" aria-controls="panel-ingestion" aria-selected="false" tabindex="-1" data-flow-tab="ingestion">Operator ingestion</button>
    </div>

    <div class="layout" id="panel-request" role="tabpanel" aria-labelledby="tab-request" data-flow-panel="request">
      <nav class="step-nav" aria-label="Atlas request steps">
        <span class="step-nav-label">Request steps</span>
        <ol class="step-list" data-step-list></ol>
      </nav>
      <section class="step-panel" data-step-panel>
        <div class="step-header">
          <span class="step-counter" data-step-counter aria-live="polite" aria-atomic="true"></span>
        </div>
        <h2 class="step-title" data-step-title tabindex="-1"></h2>
        <p class="step-scenario" data-step-scenario></p>
        <a class="step-source" data-step-source target="_blank" rel="noopener noreferrer">View source</a>
        <div class="step-controls">
          <button type="button" class="ctrl-btn" data-action="prev" disabled>Previous</button>
          <button type="button" class="ctrl-btn" data-action="next">Next</button>
          <button type="button" class="ctrl-btn ctrl-reset" data-action="reset">Reset</button>
        </div>
        <details class="step-detail-disclosure">
          <summary>How this step works</summary>
          <div class="step-detail-content" data-step-detail-content></div>
        </details>
        <div class="map-section" data-flow-map="request">
          <h3>System map focus</h3>
          <SourceMap initialFocus="" />
        </div>
      </section>
    </div>

    <div class="layout" id="panel-ingestion" role="tabpanel" aria-labelledby="tab-ingestion" data-flow-panel="ingestion" hidden>
      <nav class="step-nav" aria-label="Operator ingestion steps">
        <span class="step-nav-label">Ingestion steps</span>
        <ol class="step-list" data-step-list></ol>
      </nav>
      <section class="step-panel" data-step-panel>
        <div class="step-header">
          <span class="step-counter" data-step-counter aria-live="polite" aria-atomic="true"></span>
        </div>
        <h2 class="step-title" data-step-title tabindex="-1"></h2>
        <p class="step-scenario" data-step-scenario></p>
        <a class="step-source" data-step-source target="_blank" rel="noopener noreferrer">View source</a>
        <div class="step-controls">
          <button type="button" class="ctrl-btn" data-action="prev" disabled>Previous</button>
          <button type="button" class="ctrl-btn" data-action="next">Next</button>
          <button type="button" class="ctrl-btn ctrl-reset" data-action="reset">Reset</button>
        </div>
        <details class="step-detail-disclosure">
          <summary>How this step works</summary>
          <div class="step-detail-content" data-step-detail-content></div>
        </details>
        <div class="map-section" data-flow-map="ingestion">
          <h3>Ingestion path</h3>
          <div class="walkthrough-figure" data-figure-container>
            <div data-flow-figure="ingestion">
              <Diagram
                previewSrc="/diagrams/manual-ingestion-preview.svg"
                htmlUrl="/diagrams/manual-ingestion.html"
                alt="Manual ingestion architecture diagram"
                title="Manual ingestion"
                caption="The manual ingestion path for prepared text into the retrieval service."
              />
            </div>
          </div>
        </div>
      </section>
    </div>

    <details class="source-figure-details">
      <summary>Open the request-path reference diagram</summary>
      <div class="walkthrough-figure">
        <Diagram
          previewSrc="/diagrams/architecture-request-path-preview.svg"
          htmlUrl="/diagrams/architecture-request-path.html"
          alt="Request path architecture diagram"
          title="Request path"
          caption="The shared request operation, including MCP access, retrieval, and inference."
        />
      </div>
    </details>
  </div>
</SiteLayout>
<style>
.walkthroughs-page { padding-top: 40px; padding-bottom: 40px; }
.page-intro { max-width: 66ch; margin-bottom: 32px; }
.tabs { display: flex; gap: 0; border-bottom: 2px solid var(--color-border); margin-bottom: 32px; }
.tabs [role="tab"] {
  padding: 14px 24px;
  min-height: 44px;
  background: none;
  border: none;
  border-bottom: 3px solid transparent;
  margin-bottom: -2px;
  font-size: 16px;
  font-weight: 600;
  color: var(--color-secondary);
}
.tabs [role="tab"][aria-selected="true"] {
  color: var(--color-teal);
  border-bottom-color: var(--color-teal);
}
.layout[hidden] { display: none; }
.layout {
  min-width: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  align-items: start;
}
.step-nav {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  margin-bottom: 28px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--color-border);
}
.step-nav-label {
  flex: 0 0 auto;
  padding-top: 10px;
  color: var(--color-secondary);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.step-list { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0; counter-reset: step; }
.step-list :global(li) { counter-increment: step; }
.step-list :global(button) {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  padding: 10px 14px;
  background: none;
  border: 1px solid transparent;
  border-radius: 6px;
  font-size: 14px;
  color: var(--color-body);
  line-height: 1.4;
  cursor: pointer;
}
.step-list :global(button::before) {
  content: counter(step, decimal-leading-zero);
  display: grid;
  place-items: center;
  width: 24px;
  height: 24px;
  border: 1px solid rgba(148, 209, 219, .25);
  border-radius: 8px;
  font-size: 12px;
  font-weight: 700;
  color: var(--color-secondary);
}
.step-list :global(button:hover),
.step-list :global(button:focus-visible) {
  background: var(--color-surface);
  border-color: var(--color-border);
  outline: none;
}
.step-list :global(button[aria-current="step"]) {
  background: var(--color-surface);
  color: var(--color-ink);
  font-weight: 600;
  box-shadow: 0 1px 3px rgba(18,29,54,0.06);
  border: 1px solid var(--color-border-strong);
}
.step-panel { min-width: 0; width: 100%; border: 1px solid var(--color-border); border-radius: 8px; padding: 32px; background: var(--color-surface); }
.step-counter { font-size: 14px; font-weight: 700; color: var(--color-secondary); text-transform: uppercase; letter-spacing: 0.05em; }
.step-title { margin: 8px 0 16px; }
.step-scenario { font-size: 18px; margin-bottom: 16px; font-weight: 500; color: var(--color-ink); }
.step-detail-disclosure { margin-top: 24px; margin-bottom: 24px; border: 1px solid var(--color-border); border-radius: 8px; }
.step-detail-disclosure summary { padding: 16px; min-height: 52px; cursor: pointer; font-weight: 600; color: var(--color-teal); }
.step-detail-content { padding: 0 16px 16px; }
.step-detail-content :global(p) { max-width: 66ch; }
.step-source { font-weight: 600; display: inline-block; margin-bottom: 24px; }
.step-controls { display: flex; gap: 12px; flex-wrap: wrap; border-top: 1px solid var(--color-border); padding-top: 24px; }
.ctrl-btn {
  padding: 12px 24px;
  min-height: 44px;
  border: 2px solid var(--color-teal);
  border-radius: 6px;
  background: transparent;
  color: var(--color-teal);
  font-weight: 600;
  font-size: 15px;
  cursor: pointer;
}
.ctrl-btn:hover:not(:disabled) { background: var(--color-cool); }
.ctrl-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.ctrl-reset { border-color: var(--color-border); color: var(--color-secondary); }
.map-section { margin-top: 48px; }
.source-figure-details { margin-top: 24px; border: 1px solid var(--color-border); border-radius: 8px; }
.source-figure-details summary { padding: 16px; min-height: 52px; cursor: pointer; font-weight: 600; color: var(--color-teal); }
.walkthrough-figure { margin: 16px; }
@media (min-width: 1081px) {
  .walkthroughs-page {
    max-width: 1180px;
    margin-left: auto;
    margin-right: auto;
  }
}
@media (min-width: 1081px) {
  .step-panel { max-width: 100%; }
}
@media (max-width: 768px) {
  .step-nav { flex-direction: column; gap: 8px; }
  .step-nav-label { padding-top: 0; }
  .step-panel { padding: 20px; }
}
</style>

<script>
  import walkthroughs from '../data/walkthroughs.json';
const focusMap: Record<string, string> = {
  'current-question': 'web runtime',
  'grounding': 'runtime retrieval bge qdrant',
  'bounded-reasoning': 'runtime retrieval providers',
  'plain-answer': 'runtime web',
  'checkpoint-continuation': 'pg runtime'
};
  import { parseFlowParam, findStepIndexById, canNext, canPrev, nextState, prevState, resetState, buildUrl } from '../lib/walkthrough-state.mjs';
  import { sourceUrl } from '../lib/constants.mjs';
  import atlasExample from '../data/atlas-example.json';

  const container = document.querySelector<HTMLElement>('[data-walkthroughs]')!;
  if (container) {
    const tabButtons = Array.from(container.querySelectorAll('[data-flow-tab]')) as HTMLElement[];
    const panels = container.querySelectorAll<HTMLElement>('[data-flow-panel]');
    const sourceMap = container.querySelector('source-map');
    const state: any = {
      flow: 'request',
      stepIndex: 0,
      steps: walkthroughs.request,
      panel: null,
      stepList: null,
      counter: null,
      titleEl: null,
      scenarioEl: null,
      detailContentEl: null,
      sourceEl: null,
      prevBtn: null,
      nextBtn: null,
      resetBtn: null
    };

    state.flow = parseFlowParam(new URLSearchParams(window.location.search).get('flow'));
    state.steps = walkthroughs[state.flow as keyof typeof walkthroughs] || walkthroughs.request;
    state.stepIndex = findStepIndexById(state.flow, new URLSearchParams(window.location.search).get('step'), walkthroughs);

    function initPanel(flow: string) {
      const panel = container.querySelector(`[data-flow-panel="${flow}"]`);
      if (!panel) return;
      state.panel = panel;
      state.stepList = panel.querySelector('[data-step-list]');
      state.counter = panel.querySelector('[data-step-counter]');
      state.titleEl = panel.querySelector('[data-step-title]');
      state.scenarioEl = panel.querySelector('[data-step-scenario]');
      state.detailContentEl = panel.querySelector('[data-step-detail-content]');
      state.sourceEl = panel.querySelector('[data-step-source]');
      state.prevBtn = panel.querySelector('[data-action="prev"]');
      state.nextBtn = panel.querySelector('[data-action="next"]');
      state.resetBtn = panel.querySelector('[data-action="reset"]');
    }

    function renderTabs() {
      tabButtons.forEach(btn => {
        const isActive = btn.dataset.flowTab === state.flow;
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        btn.setAttribute('tabindex', isActive ? '0' : '-1');
      });
    }

    function renderPanels() {
      panels.forEach(p => {
        p.hidden = p.getAttribute('data-flow-panel') !== state.flow;
      });
      initPanel(state.flow);
    }

    function renderStepList() {
      state.stepList.innerHTML = '';
      state.steps.forEach((step: any, i: number) => {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.textContent = step.title;
        if (i === state.stepIndex) btn.setAttribute('aria-current', 'step');
        btn.addEventListener('click', () => {
          state.stepIndex = i;
          update('push');
          const desktop = window.matchMedia('(min-width: 1081px)');
          if (desktop.matches) {
            const current = state.stepList.querySelectorAll('button')[state.stepIndex];
            if (current) current.focus();
          } else if (state.titleEl) {
            state.titleEl.id = 'step-' + state.flow + '-' + state.steps[state.stepIndex].id;
            state.titleEl.setAttribute('tabindex', '-1');
            state.titleEl.focus({ preventScroll: true });
            state.titleEl.scrollIntoView({ block: 'start' });
          }
        });
        li.appendChild(btn);
        state.stepList.appendChild(li);
      });
    }

    function update(mode: any) {
      const step = state.steps[state.stepIndex];
      renderTabs();
      renderPanels();
      renderStepList();

      state.counter.textContent = `Step ${state.stepIndex + 1} of ${state.steps.length}`;
      state.titleEl.textContent = step.title;
      state.titleEl.id = 'step-' + state.flow + '-' + step.id;
      state.scenarioEl.textContent = step.description;
      state.detailContentEl.innerHTML = '';
      const detailP = document.createElement('p');
      detailP.textContent = step.detail;
      state.detailContentEl.appendChild(detailP);

      const src = step.source;
      if (src && src.path) {
        state.sourceEl.href = sourceUrl(src.path, src.heading || '');
        state.sourceEl.textContent = `View source: ${src.heading || src.path}`;
        state.sourceEl.style.display = '';
      } else {
        state.sourceEl.style.display = 'none';
      }

      state.prevBtn.disabled = !canPrev(state);
      state.nextBtn.disabled = !canNext(state);
      state.resetBtn.disabled = state.stepIndex === 0;

      if (state.flow === 'request') {
        const atlasStep = (atlasExample as any).steps.find((s: any) => s.id === step.id);
        if (atlasStep) {
          let context = '';
          if (step.id === 'current-question') {
            context = `Fictional scenario: ${(atlasExample as any).question}`;
          } else if (step.id === 'grounding') {
            context = 'Fictional scenario: retrieved project notes say “Release checklist: load test pending” and “Recovery notes: rollback rehearsal pending”.';
          } else if (step.id === 'plain-answer') {
            context = `Fictional scenario: returns “${(atlasExample as any).answer}”`;
          } else {
            context = `Fictional scenario: ${atlasStep.label}. ${atlasStep.detail}`;
          }
          state.scenarioEl.textContent = context;
        }
      }

      if (state.flow === 'request' && sourceMap) {
        const focusIds = (focusMap as Record<string, string>)[step.id] || '';
        sourceMap.setAttribute('data-active', focusIds);
      } else if (sourceMap) {
        sourceMap.setAttribute('data-active', '');
      }

      if (mode && mode !== 'none') {
        const newUrl = buildUrl(state.flow, step.id);
        if (mode === 'replace') {
          window.history.replaceState({ flow: state.flow, stepId: step.id }, '', newUrl);
        } else if (mode === 'push') {
          const currentUrl = window.location.pathname + window.location.search;
          if (currentUrl !== newUrl) {
            window.history.pushState({ flow: state.flow, stepId: step.id }, '', newUrl);
          } else {
            window.history.replaceState({ flow: state.flow, stepId: step.id }, '', newUrl);
          }
        }
      }
    }

    function focusCurrentStep() {
      if (!state.titleEl) return;
      state.titleEl.id = 'step-' + state.flow + '-' + state.steps[state.stepIndex].id;
      state.titleEl.setAttribute('tabindex', '-1');
      state.titleEl.focus({ preventScroll: true });
    }

    function setFlow(newFlow: string) {
      state.flow = parseFlowParam(newFlow);
      state.steps = walkthroughs[state.flow as keyof typeof walkthroughs];
      state.stepIndex = 0;
      update('replace');
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => setFlow(btn.dataset.flowTab!));
      btn.addEventListener('keydown', (e) => {
        let index = tabButtons.findIndex(t => t.getAttribute('tabindex') === '0');
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          index = (index + 1) % tabButtons.length;
          tabButtons[index].click();
          tabButtons[index].focus();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          index = (index - 1 + tabButtons.length) % tabButtons.length;
          tabButtons[index].click();
          tabButtons[index].focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          tabButtons[0].click();
          tabButtons[0].focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          tabButtons[tabButtons.length - 1].click();
          tabButtons[tabButtons.length - 1].focus();
        }
      });
    });

    container.addEventListener('click', (e) => {
      const action = (e.target as HTMLElement).closest('[data-action]')?.getAttribute('data-action');
      if (!action) return;
      if (action === 'prev') {
        const s = prevState(state);
        state.stepIndex = s.stepIndex; update('push'); focusCurrentStep();
      } else if (action === 'next') {
        const s = nextState(state);
        state.stepIndex = s.stepIndex; update('push'); focusCurrentStep();
      } else if (action === 'reset') {
        const s = resetState(state);
        state.stepIndex = s.stepIndex; update('push'); focusCurrentStep();
      }
    });

    window.addEventListener('popstate', () => {
      const params = new URLSearchParams(window.location.search);
      state.flow = parseFlowParam(params.get('flow'));
      state.steps = walkthroughs[state.flow as keyof typeof walkthroughs];
      state.stepIndex = findStepIndexById(state.flow, params.get('step'), walkthroughs);
      update('none');
    });

    const canonicalParams = new URLSearchParams();
    canonicalParams.set('flow', state.flow);
    canonicalParams.set('step', state.steps[state.stepIndex].id);
    const canonicalUrl = buildUrl(state.flow, state.steps[state.stepIndex].id);
    if (window.location.search !== canonicalUrl) {
      window.history.replaceState({ flow: state.flow, stepId: state.steps[state.stepIndex].id }, '', canonicalUrl);
    }

    update('none');
  }
</script>
