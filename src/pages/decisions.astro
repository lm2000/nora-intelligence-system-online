---
import SiteLayout from '../layouts/SiteLayout.astro';
import { href } from '../lib/constants.mjs';
import PageIndex from '../components/PageIndex.astro';
import { Content } from '../content/decisions.md';
---
<SiteLayout title="Decisions — Nora SuperIntelligence Lab" description="Architecture decisions for Nora SuperIntelligence Lab’s AI agent harness." path="/decisions/">
  <article class="container content-page" data-supporting-page="decisions">
    <h1 id="decisions">Decisions</h1>
    <p class="page-intro" id="purpose">Current accepted choices for the AI agent harness. Deployment evidence belongs on <a href={href('/validation/')}>Validation</a>; superseded choices remain in Git history.</p>
    <PageIndex />
    <Content />
  </article>
</SiteLayout>
<style>
.content-page { padding-top: 40px; padding-bottom: 40px; }
.content-page :global(p) { font-size: 18px; line-height: 1.7; max-width: 66ch; }
.content-page :global(h2) { margin-top: 2.5em; }
.content-page .page-intro { scroll-margin-top: calc(var(--header-height) + 24px); font-size: 18px; line-height: 1.7; max-width: 66ch; color: var(--ink-soft); }
</style>
