---
import SiteLayout from '../../layouts/SiteLayout.astro';
import OriginalIndex from '../../components/OriginalIndex.astro';
import { href } from '../../lib/constants.mjs';

const entries = [
  { id: 'overview', label: 'Overview', description: 'Lab work and research' },
  { id: 'knowledge-assistant', label: 'Knowledge assistant', description: 'Retrieval, tools, and state' },
  { id: 'interview-preparation', label: 'Job search', description: 'Search, prepare, and keep learning' },
  { id: 'client-research', label: 'Client research', description: 'Research and pitch preparation' },
  { id: 'ai-data-readiness', label: 'AI/data readiness', description: 'Choose and scope a first pilot' },
  { id: 'ai-harness-landscape', label: 'AI Harness Landscape', description: 'Public-source research' },
  { id: 'workflow-contact', label: 'Contact', description: 'Discuss a similar workflow' }
];
---
<SiteLayout title="Use cases — Nora SuperIntelligence Lab" description="Explore knowledge-assistant work, job-search automation, agency workflows, AI/data readiness, and AI Harness Landscape research from Nora SuperIntelligence Lab." path="/use-cases/" customIndex={true}>
  <section class="hero use-cases-hero" id="overview" data-index-label="Overview">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--one" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--two" aria-hidden="true"></div>
    <div class="shell hero-layout">
      <div class="hero-copy">
        <h1>Use cases.</h1>
        <p class="hero-lede">Explore practical workflows for knowledge assistants, job search, agency research and venture diligence. Use the readiness method to choose a first pilot.</p>
      </div>
      <OriginalIndex tagline="Nora SuperIntelligence Lab" title="Use cases" entries={entries} ariaLabel="Use cases navigation" grouped={true} />
    </div>
  </section>
  <section class="section use-case-directory" aria-label="Choose a use case">
    <div class="shell">
      <div class="use-case-grid">
        <article id="knowledge-assistant" class="use-case-entry">
          <p class="section-label">Implemented project</p>
          <h2>Knowledge assistant</h2>
          <p>Find an answer in prepared documents and continue with retained context. Follow a fictional Atlas question through retrieval, tools, and conversation state.</p>
          <a class="text-link" href={href('/walkthroughs/?flow=request&step=current-question')}>Follow the example <span aria-hidden="true">→</span></a>
        </article>
        <article id="interview-preparation" class="use-case-entry">
          <p class="section-label">Illustrative workflow</p>
          <h2>Job search and continuous learning</h2>
          <p>Connect targeting, applications, outreach, interviews, and self-learning. Keep an opportunity pipeline, stage briefs, and a learning record connected.</p>
          <a class="text-link" href={href('/case-studies/interview-preparation/')}>Explore the career cycle <span aria-hidden="true">→</span></a>
        </article>
        <article id="client-research" class="use-case-entry">
          <p class="section-label">Illustrative workflow</p>
          <h2>Client research and agency workflow</h2>
          <p>Start with a ten-account shortlist, choose three for focused briefs, and prepare tailored pitch packages. Explore the account-learning loop after the conversation.</p>
          <a class="text-link" href={href('/case-studies/client-research/')}>Explore the agency workflow <span aria-hidden="true">→</span></a>
        </article>
        <article id="ai-data-readiness" class="use-case-entry">
          <p class="section-label">Assessment method</p>
          <h2>AI and data readiness</h2>
          <p>Rank opportunities, review data and integration gaps, and define one pilot with a baseline, owner, and evaluation plan.</p>
          <a class="text-link" href={href('/case-studies/ai-data-readiness/')}>View the assessment <span aria-hidden="true">→</span></a>
        </article>
        <article id="ai-harness-landscape" class="use-case-entry">
          <p class="section-label">Public-source research</p>
          <h2>AI Harness Landscape</h2>
          <p>Compare seven public AI products through workflow, integration, review, adoption, and economics. Develop a source-linked research brief.</p>
          <a class="text-link" href={href('/case-studies/ai-harness-landscape/')}>Read the research <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>
  <section class="section workflow-section" id="workflow-contact" data-index-label="Contact">
    <div class="shell">
      <div class="section-heading">
        <h2>Have a similar workflow in mind?</h2>
        <p>Discuss a scoped workflow project with Michael Lvov. Independent work at Nora SuperIntelligence Lab informs my engineering services: readiness assessments, architecture reviews and scoped prototypes with an evaluation plan.</p>
      </div>
      <a class="button button--primary" href="mailto:michael.lm00@gmail.com">Discuss a workflow with Michael <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>
<style>
  .use-cases-hero, .use-cases-hero .hero-layout { min-height: 0; }
  .use-cases-hero .hero-layout { padding-block: 32px; }
  .use-cases-hero :global(.mini-flow small), .use-cases-hero :global(.loop-line) { display: none; }
  .use-cases-hero :global(.mini-flow li) { min-height: 44px; margin-bottom: 4px; }
  .use-cases-hero :global(.mini-flow a) { display: flex; align-items: center; min-height: 44px; }
  .use-case-directory { padding-block: 36px 64px; }
  .use-case-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .use-case-entry { padding: 24px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--navy-2); scroll-margin-top: calc(var(--header-height) + 24px); }
  .use-case-entry h2 { font-size: 28px; margin: 0 0 12px; }
  .use-case-entry > p:not(.section-label) { margin: 0 0 16px; color: var(--ink-soft); line-height: 1.6; max-width: 48ch; }
  .use-case-entry .text-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; }
  @media (max-width: 680px) {
    .use-cases-hero .hero-layout { padding-block: 28px; gap: 20px; }
    .use-case-grid { grid-template-columns: 1fr; gap: 16px; }
    .use-case-directory { padding-top: 24px; }
    .use-case-entry { padding: 20px; }
  }
</style>
