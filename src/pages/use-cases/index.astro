---
import SiteLayout from '../../layouts/SiteLayout.astro';
import OriginalIndex from '../../components/OriginalIndex.astro';
import { href } from '../../lib/constants.mjs';

const entries = [
  { id: 'overview', label: 'Overview', description: 'Practical work and research from the lab' },
  { id: 'knowledge-assistant', label: 'Knowledge assistant', description: 'Prepared knowledge, tools, and conversation state' },
  { id: 'interview-preparation', label: 'Interview preparation', description: 'Prepare, rehearse, and debrief' },
  { id: 'client-research', label: 'Client research', description: 'Research and pitch preparation' },
  { id: 'ai-harness-landscape', label: 'AI Harness Landscape', description: 'A public-source research case study' }
];
---
<SiteLayout title="Use cases — Nora SuperIntelligence Lab" description="Explore knowledge-assistant work, interview preparation, client research, and AI Harness Landscape research from Nora SuperIntelligence Lab." path="/use-cases/" customIndex={true}>
  <section class="hero" id="overview" data-index-label="Overview">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--one" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--two" aria-hidden="true"></div>
    <div class="shell hero-layout">
      <div class="hero-copy">
        <h1>Use cases.</h1>
        <p class="hero-lede">Explore practical work and research from Nora SuperIntelligence Lab: knowledge assistants, interview preparation, client research, and the workflows around AI products.</p>
      </div>
      <OriginalIndex tagline="Nora SuperIntelligence Lab" title="Use cases" entries={entries} ariaLabel="Use cases navigation" />
    </div>
  </section>
  <section class="section" id="knowledge-assistant" data-index-label="Knowledge assistant">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div><p class="section-label">Knowledge-assistant project</p><h2>Answer a question with prepared knowledge.</h2></div>
        <p>The lab’s assistant combines retrieval, tool use, and durable conversation state. The fictional Atlas walkthrough shows how a question about release blockers moves through the system.</p>
      </div>
      <div class="hero-actions">
        <a class="button button--primary" href={href('/walkthroughs/?flow=request&step=current-question')}>Follow the example <span aria-hidden="true">→</span></a>
        <a class="text-link" href={href('/architecture/')}>Read the architecture <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <section class="section foundation-section" id="interview-preparation" data-index-label="Interview preparation">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div><p class="section-label">Preparation workflow</p><h2>Prepare for the next interview stage.</h2></div>
        <p>Connect role requirements, experience, research, and rehearsal in one preparation workflow. Keep the stage brief, practice feedback, and next action together.</p>
      </div>
      <a class="button button--primary" href={href('/case-studies/interview-preparation/')}>Explore interview preparation <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="section" id="client-research" data-index-label="Client research">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div><p class="section-label">Workflow concept</p><h2>Prepare a client conversation with useful context.</h2></div>
        <p>A proposed workflow: research a shortlist, develop a relevant point of view, and prepare a pitch for human review. The agency owns account selection and the conversation.</p>
      </div>
      <a class="button button--primary" href={href('/case-studies/client-research/')}>Explore client research <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="section foundation-section" id="ai-harness-landscape" data-index-label="AI Harness Landscape">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div><p class="section-label">Research case study</p><h2>AI Harness Landscape.</h2></div>
        <p>Compare seven public product examples across legal, compliance, and healthcare workflows. Examine the questions behind knowledge sources, tools, persistent state, human review, and integration.</p>
      </div>
      <a class="button button--primary" href={href('/case-studies/ai-harness-landscape/')}>Read the case study <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>
