---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIndex from '../components/PageIndex.astro';
import { Content } from '../content/reproduce.md';
---
<SiteLayout title="Reproduce — Nora SuperIntelligence Lab" description="Reproduction steps for the Nora intelligence system." path="/reproduce/">
  <article class="container content-page" data-supporting-page="reproduce">
    <h1 id="reproduce">Reproduce</h1>
    <p class="page-intro" id="purpose">Run the Nora knowledge-agent harness checks from pinned public source. These development checks use synthetic documents and model doubles.</p>
    <PageIndex />
    <Content />
  </article>
</SiteLayout>
<style>
.content-page { padding-top: 40px; padding-bottom: 40px; }
.content-page :global(p) { font-size: 18px; line-height: 1.7; max-width: 66ch; }
.content-page :global(h2) { margin-top: 2.5em; }
.content-page .page-intro { scroll-margin-top: calc(var(--header-height) + 24px); font-size: 18px; line-height: 1.7; max-width: 66ch; color: var(--ink-soft); }
</style>
