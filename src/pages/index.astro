---
import SiteLayout from '../layouts/SiteLayout.astro';
import Diagram from '../components/Diagram.astro';
import CTAButton from '../components/CTAButton.astro';
import { href } from '../lib/constants.mjs';
import site from '../data/site.json';
import walkthroughs from '../data/walkthroughs.json';

const firstRequestStep = walkthroughs.request[0].id;
const founders = site.founders.filter(f => f && f.name);
---
<SiteLayout title="Nora Intelligence System — Architecture" description="One assistant. Clear service boundaries. Explore how a knowledge assistant retrieves prepared documents, produces an answer, and keeps conversation state." path="/">
  <section class="hero container">
    <h1>{site.home.heading} <span class="emphasis">{site.home.headingEmphasis}</span></h1>
    <p class="hero-intro">{site.home.intro}</p>
    <div class="cta-group">
      <CTAButton href={`/walkthroughs/?flow=request&step=${firstRequestStep}`} label="Follow a request" icon="arrow" />
      <CTAButton href="/architecture/" label="Read the architecture" variant="outline" icon="arrow" />
    </div>
  </section>

  <section class="container architecture-section">
    <Diagram
      previewSrc="/diagrams/01-system-architecture-preview.svg"
      htmlUrl="/diagrams/01-system-architecture.html"
      gifUrl="/diagrams/01-system-architecture.gif"
      sourcePath="diagrams/01-system-architecture.html"
      title="System architecture"
      purpose="A complete view of the Nora Intelligence System boundaries and primary components."
      alt="System architecture diagram showing Browser UI AG-UI connects directly to Coordination. MCP clients separately use LiteLLM MCP gateway to embedded FastMCP or direct FastMCP."
      caption="Browser conversations reach Coordination through AG-UI. MCP clients use the gateway or embedded FastMCP; retrieval, inference, and checkpoint storage remain separate."
    />
  </section>

  <section class="container example-section">
    <h2>Worked example — Fictional Atlas</h2>
    <div class="example-strip">
      <div class="example-cell">
        <span class="cell-label">Question</span>
        <p class="cell-text">{site.home.exampleQuestion}</p>
      </div>
      <div class="example-cell">
        <span class="cell-label">Answer</span>
        <p class="cell-text">{site.home.exampleAnswer}</p>
      </div>
    </div>
    <div class="example-cta">
      <CTAButton href="/walkthroughs/" label="Explore walkthrough" icon="arrow" />
    </div>
  </section>

  <section id="founders" class="container founders-section">
    <h2>Founders</h2>
    <div class="founders-grid">
      {founders.map(f => (
        <article class="founder-card">
          {f.image && <img src={href('/' + f.image)} alt={`Portrait of ${f.name}`} width="160" height="160" class="founder-portrait" />}
          <div class="founder-body">
            <h3>{f.name}</h3>
            {f.role && <p class="founder-role">{f.role}</p>}
            {f.bio && <p class="founder-bio">{f.bio}</p>}
            {f.focus && f.focus.length > 0 && (
              <ul class="founder-focus">
                {f.focus.map(item => <li>{item}</li>)}
              </ul>
            )}
            <div class="founder-links">
              {f.links && f.links.map(l => (
                <a href={l.url} target="_blank" rel="noopener noreferrer" class="founder-link">
                  <span>{l.label}</span>
                  <img src={href('/images/icons/external-link.svg')} alt="" width="18" height="18" />
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  {site.contact && (
    <section class="container contact-section">
      <h2>{site.contact.heading}</h2>
      <p>{site.contact.body}</p>
      <div class="contact-links">
        {site.contact.links.map(l => (
          <a href={l.url} class="contact-link">{l.label}</a>
        ))}
      </div>
    </section>
  )}
</SiteLayout>
<style>
.hero {
  padding-top: 40px;
  padding-bottom: 20px;
}
.hero h1 {
  margin-bottom: 24px;
}
.emphasis {
  color: var(--color-muted-blue);
}
.hero-intro {
  font-size: 21px;
  max-width: 67ch;
  margin-bottom: 32px;
}
.cta-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}
.architecture-section {
  padding-top: 20px;
  padding-bottom: 20px;
}
.example-section {
  padding-top: 40px;
}
.example-section h2 {
  margin-bottom: 24px;
}
.example-strip {
  display: flex;
  border: 1px solid var(--color-border);
  border-radius: 8px;
  overflow: hidden;
}
.example-cell {
  flex: 1;
  padding: 24px;
}
.example-cell:first-child {
  border-right: 1px solid var(--color-border);
  background: var(--color-cool);
}
.cell-label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-secondary);
  margin-bottom: 8px;
}
.cell-text {
  margin: 0;
  font-size: 18px;
  color: var(--color-ink);
}
.example-cta {
  margin-top: 24px;
}
#founders {
  scroll-margin-top: 100px;
}
.founders-section {
  padding-top: 60px;
}
.founders-grid {
  display: grid;
  gap: 32px;
}
.founder-card {
  display: flex;
  gap: 32px;
  align-items: flex-start;
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 32px;
}
.founder-portrait {
  width: 160px;
  height: 160px;
  object-fit: cover;
  border-radius: 4px;
  border: 8px solid var(--color-cool);
  flex-shrink: 0;
}
.founder-body h3 { margin-bottom: 4px; }
.founder-role {
  color: var(--color-muted-blue);
  font-weight: 600;
  font-size: 16px;
  margin: 0 0 16px;
}
.founder-bio { margin-bottom: 16px; }
.founder-focus {
  list-style: none;
  padding: 0;
  margin: 0 0 20px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.founder-focus li {
  font-size: 14px;
  color: var(--color-secondary);
  background: var(--color-cool);
  padding: 4px 12px;
  border-radius: 100px;
}
.founder-links {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}
.founder-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  text-decoration: none;
  color: var(--color-teal);
  font-weight: 600;
  font-size: 15px;
}
.founder-link:hover { text-decoration: underline; }
.contact-section {
  padding-top: 60px;
  padding-bottom: 20px;
}
.contact-links {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  margin-top: 16px;
}
.contact-link {
  font-weight: 600;
}
@media (max-width: 768px) {
  .example-strip { flex-direction: column; }
  .example-cell:first-child { border-right: none; border-bottom: 1px solid var(--color-border); }
  .founder-card { flex-direction: column; align-items: center; text-align: center; padding: 24px; }
  .founder-portrait { width: 128px; height: 128px; }
  .founder-focus { justify-content: center; }
  .founder-links { justify-content: center; }
}
</style>
