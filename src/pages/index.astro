---
import SiteLayout from '../layouts/SiteLayout.astro';
import OriginalIndex from '../components/OriginalIndex.astro';
import { href } from '../lib/constants.mjs';
import site from '../data/site.json';
import walkthroughs from '../data/walkthroughs.json';

const firstRequestStep = walkthroughs.request[0].id;
const founder = site.founders.filter(f => f && f.name)[0];

const indexEntries = [
  { id: 'overview', label: 'Overview', description: 'The lab and its current knowledge-assistant work' },
  { id: 'example', label: 'Current work', description: 'Nora, the knowledge-assistant project' },
  { id: 'system-map', label: 'Approach', description: 'A practical way to build useful systems' },
  { id: 'founders', label: 'Founders', description: 'Michael and the work behind the lab' },
  { id: 'contact', label: 'Contact', description: 'Get in touch about roles or projects' }
];
---
<SiteLayout title="Home — Nora SuperIntelligence Lab" description="I lead Nora SuperIntelligence Lab, an independent lab building knowledge assistants and practical AI systems. Nora is the current knowledge-assistant project." path="/" customIndex={true}>
  <section class="hero hero--home" id="overview" data-index-label="Overview">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--one" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--two" aria-hidden="true"></div>
    <div class="shell hero-layout">
      <div class="hero-copy">
        <h1>{site.home.heading} {site.home.headingEmphasis}</h1>
        <p class="hero-lede">{site.home.intro}</p>
        <div class="hero-actions home-actions">
          <a class="button button--primary" href={href('/architecture/')}>Explore Nora <span aria-hidden="true">→</span></a>
          <a class="button button--ghost" href={href(`/walkthroughs/?flow=request&step=${firstRequestStep}`)}>Follow a walkthrough <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <OriginalIndex tagline="HOME" title="Inside the lab" entries={indexEntries} ariaLabel="Home navigation" />
    </div>
  </section>

  <section class="home-process" aria-labelledby="home-process-title">
    <div class="shell">
      <div class="home-process__intro">
        <div>
          <p class="section-label">How the work moves</p>
          <h2 id="home-process-title">A concrete question becomes an inspectable answer.</h2>
        </div>
        <p>Nora keeps the path visible: a question is grounded in prepared knowledge, connected to tools, carried through conversation state, and returned as an answer someone can examine.</p>
      </div>
      <ol class="home-process__flow" aria-label="Nora request flow">
        <li>
          <span aria-hidden="true">01</span>
          <strong>Question</strong>
          <p>Start with the task that needs attention.</p>
        </li>
        <li>
          <span aria-hidden="true">02</span>
          <strong>Prepared knowledge</strong>
          <p>Use the context that can inform the work.</p>
        </li>
        <li>
          <span aria-hidden="true">03</span>
          <strong>Tools</strong>
          <p>Coordinate the people, agents, and systems involved.</p>
        </li>
        <li>
          <span aria-hidden="true">04</span>
          <strong>Conversation state</strong>
          <p>Keep handoffs and supporting context connected.</p>
        </li>
        <li>
          <span aria-hidden="true">05</span>
          <strong>Inspectable answer</strong>
          <p>Make review and the next action explicit.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" id="example" data-index-label="Current work">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div>
          <p class="section-label">Current work</p>
          <h2>Nora, a knowledge assistant.</h2>
        </div>
        <p>Nora explores how an assistant can work with prepared knowledge, use tools, and retain conversation state. Its public harness makes the architecture and checks available to examine.</p>
      </div>
      <div class="hero-actions home-actions">
        <a class="text-link" href={href('/architecture/')}>Architecture <span aria-hidden="true">→</span></a>
        <a class="text-link" href={href(`/walkthroughs/?flow=request&step=${firstRequestStep}`)}>Walkthroughs <span aria-hidden="true">→</span></a>
        <a class="text-link" href={href('/workflows/')}>Workflows <span aria-hidden="true">→</span></a>
        <a class="text-link" href={href('/case-study/')}>How NIS was built <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section foundation-section" id="system-map" data-index-label="Approach">
    <div class="shell foundation-layout">
      <div class="foundation-copy">
        <p class="section-label">Approach</p>
        <h2>A practical way to build.</h2>
        <a class="text-link" href={href('/validation/')}>See how the work is validated <span aria-hidden="true">→</span></a>
      </div>
      <div class="foundation-list" role="list">
        <div role="listitem">
          <span>01</span>
          <p><strong>Start with a concrete use case.</strong> Use a concrete task to guide what the system needs to do.</p>
        </div>
        <div role="listitem">
          <span>02</span>
          <p><strong>Keep responsibilities clear.</strong> Make each responsibility explicit so the system is easier to understand and change.</p>
        </div>
        <div role="listitem">
          <span>03</span>
          <p><strong>Make the work inspectable.</strong> Keep source, architectural decisions, and checks available for review.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section foundation-section" id="founders" data-index-label="Founders">
    <div class="shell foundation-layout">
      <div class="foundation-copy">
        <p class="section-label">Founders</p>
        <h2>I’m Michael Lvov. I lead the current Nora knowledge-assistant project.</h2>
      </div>
      {founder && (
        <div class="foundation-list">
          <div class="founder-entry">
            <span>01</span>
            <p><strong>I’m Michael.</strong> I’m exploring how people, knowledge, agents, and tools can work together without losing human judgment.</p>
            <p class="founder-links"><a class="text-link" href={href('/founders/')}>More about me <span aria-hidden="true">→</span></a></p>
          </div>
        </div>
      )}
    </div>
  </section>

  {site.contact && (
    <section class="section pilots-section" id="contact" data-index-label="Contact">
      <div class="shell">
        <div class="section-heading section-heading--split">
          <div>
            <p class="section-label">Contact</p>
            <h2>Discuss a role or project.</h2>
          </div>
          <p>I’m open to technical leadership roles and AI or data-platform projects. The Founders page has the fuller profile and contact context.</p>
        </div>
        <div class="hero-actions">
          {site.contact.links.map(l => (
            <a class="button button--primary" href={l.url}>{l.label} <span aria-hidden="true">→</span></a>
          ))}
        </div>
      </div>
    </section>
  )}
</SiteLayout>
<style>
.home-actions {
  margin-top: 24px;
}
.home-actions { gap: 20px; }
.founder-entry { position: relative; }
div.founder-entry > p { margin: 0; }
.founder-links { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 18px; grid-column: 2; }

.home-process {
  position: relative;
  padding: 88px 0 92px;
  overflow: hidden;
  border-top: 1px solid rgba(178, 205, 219, 0.1);
  border-bottom: 1px solid rgba(178, 205, 219, 0.1);
  background: linear-gradient(180deg, rgba(11, 36, 54, 0.72), rgba(7, 24, 39, 0.18));
}
.home-process::before {
  position: absolute;
  top: -140px;
  right: 10%;
  width: 500px;
  height: 240px;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(112, 103, 240, 0.18), transparent 68%);
  content: '';
  pointer-events: none;
}
.home-process__intro {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.62fr);
  align-items: end;
  gap: 48px;
  margin-bottom: 42px;
}
.home-process__intro h2 { max-width: 650px; margin-bottom: 0; }
.home-process__intro > p { max-width: 430px; margin: 0; color: var(--ink-soft); }
.home-process__flow {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.home-process__flow li {
  position: relative;
  min-height: 182px;
  padding: 20px 18px 18px;
  border: 1px solid rgba(178, 205, 219, 0.16);
  border-radius: 16px;
  background: rgba(7, 24, 39, 0.74);
  box-shadow: 0 18px 38px rgba(1, 11, 18, 0.12);
}
.home-process__flow li:not(:last-child)::after {
  position: absolute;
  top: 50%;
  right: -17px;
  width: 22px;
  height: 1px;
  background: linear-gradient(90deg, rgba(19, 185, 157, 0.7), rgba(112, 103, 240, 0.7));
  content: '';
}
.home-process__flow li:not(:last-child)::before {
  position: absolute;
  top: calc(50% - 4px);
  right: -17px;
  width: 7px;
  height: 7px;
  border-top: 1px solid rgba(112, 103, 240, 0.9);
  border-right: 1px solid rgba(112, 103, 240, 0.9);
  content: '';
  transform: rotate(45deg);
}
.home-process__flow li > span {
  display: block;
  margin-bottom: 26px;
  color: #72ead8;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.16em;
}
.home-process__flow strong { display: block; margin-bottom: 8px; color: var(--white); font-size: 0.96rem; line-height: 1.2; }
.home-process__flow p { margin: 0; color: var(--ink-soft); font-size: 0.875rem; line-height: 1.5; }
@media (max-width: 1080px) {
  .home-process__intro { grid-template-columns: 1fr; gap: 18px; }
  .home-process__intro > p { max-width: 660px; }
  .home-process__flow { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .home-process__flow li:not(:last-child)::after,
  .home-process__flow li:not(:last-child)::before { display: none; }
}
@media (max-width: 680px) {
  .home-process { padding: 72px 0 76px; }
  .home-process__flow { grid-template-columns: 1fr; }
  .home-process__flow li { min-height: auto; }
  .home-process__flow li > span { margin-bottom: 16px; }
}
</style>
