---
import SiteLayout from '../layouts/SiteLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import SourceMap from '../components/SourceMap.astro';
import { href } from '../lib/constants.mjs';
import site from '../data/site.json';
import walkthroughs from '../data/walkthroughs.json';
import atlasExample from '../data/atlas-example.json';

const firstRequestStep = walkthroughs.request[0].id;
const founders = site.founders.filter(f => f && f.name);
---
<SiteLayout title="Nora SuperIntelligence Lab — Architecture" description="One assistant. Clear service boundaries. Explore how a knowledge assistant retrieves prepared documents, produces an answer, and keeps conversation state." path="/">
  <section id="overview" class="hero container">
    <div class="hero-content">
      <h1>{site.home.heading} <span class="emphasis">{site.home.headingEmphasis}</span></h1>
      <p class="hero-intro">{site.home.intro}</p>
      <div class="cta-group">
        <CTAButton href={`/walkthroughs/?flow=request&step=${firstRequestStep}`} label="Follow a request" icon="arrow" />
        <CTAButton href={'/architecture/'} label="Read the architecture" variant="outline" icon="arrow" />
      </div>
    </div>
    <div class="hero-map">
      <SourceMap initialFocus="" />
    </div>
  </section>

  <section id="explore" class="container journey-section">
    <h2>Explore the system</h2>
    <ol class="journey-list">
      <li>
        <a href={href(`/walkthroughs/?flow=request&step=current-question`)}>
          <span class="step-number">1</span>
          <span class="step-label">Follow a request</span>
        </a>
        <p class="step-subtitle">Walk through the Browser UI to Coordination flow.</p>
      </li>
      <li>
        <a href={href('/architecture/#decisions-tradeoffs')}>
          <span class="step-number">2</span>
          <span class="step-label">Examine decisions</span>
        </a>
        <p class="step-subtitle">Review NIS service boundaries and tradeoffs.</p>
      </li>
      <li>
        <a href={href('/validation/')}>
          <span class="step-number">3</span>
          <span class="step-label">Validation</span>
        </a>
        <p class="step-subtitle">Inspect validation and checkpoint persistence.</p>
      </li>
      <li>
        <a href={href('/reproduce/')}>
          <span class="step-number">4</span>
          <span class="step-label">Reproduce</span>
        </a>
        <p class="step-subtitle">Understand reproduction steps and limitations.</p>
      </li>
    </ol>
  </section>

  <section id="example" class="container example-section" data-index-label="Atlas example">
    <h2>Worked example — Fictional Atlas</h2>
    <div class="example-strip">
      <div class="example-cell">
        <span class="cell-label">Question</span>
        <p class="cell-text">{atlasExample.question}</p>
      </div>
      <div class="example-cell">
        <span class="cell-label">Answer</span>
        <p class="cell-text">{atlasExample.answer}</p>
      </div>
    </div>
    <details class="example-details">
      <summary>View illustrative steps</summary>
      <ol>
        {atlasExample.steps.map(step => (
          <li>
            <strong>{step.label}:</strong> {step.detail}
          </li>
        ))}
      </ol>
    </details>
    <div class="example-cta">
      <CTAButton href={`/walkthroughs/?flow=request&step=${firstRequestStep}`} label="Explore walkthrough" icon="arrow" />
    </div>
  </section>

  <section id="founders" class="container founders-section">
    <h2>Founders</h2>
    <div class="founders-grid">
      {founders.map(f => (
        <article class="founder-card">
          {f.image && <img src={href('/' + f.image)} alt={`Portrait of ${f.name}`} width="160" height="160" class="founder-portrait" />}
          <div class="founder-body">
            <h3>{f.name}</h3>
            {f.role && <p class="founder-role">{f.role}</p>}
            {f.bio && <p class="founder-bio">{f.bio}</p>}
            {f.focus && f.focus.length > 0 && (
              <ul class="founder-focus">
                {f.focus.map(item => <li>{item}</li>)}
              </ul>
            )}
            <div class="founder-links">
              {f.links && f.links.map(l => (
                <a href={l.url} target="_blank" rel="noopener noreferrer" class="founder-link">
                  <span>{l.label}</span>
                  <img src={href('/images/icons/external-link.svg')} alt="" width="18" height="18" />
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  {site.contact && (
    <section id="contact" class="container contact-section" data-index-label="Contact">
      <h2>{site.contact.heading}</h2>
      <p>{site.contact.body}</p>
      <div class="contact-links">
        {site.contact.links.map(l => (
          <a href={l.url} class="contact-link">{l.label}</a>
        ))}
      </div>
    </section>
  )}
</SiteLayout>
<style>
.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  padding-top: 40px;
  padding-bottom: 20px;
  align-items: center;
}
.hero h1 {
  margin-bottom: 24px;
}
.emphasis {
  color: var(--color-muted-blue);
}
.hero-intro {
  font-size: 21px;
  max-width: 67ch;
  margin-bottom: 32px;
}
.cta-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}
.journey-section {
  padding-top: 40px;
}
.journey-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 24px;
  counter-reset: journey;
}
.journey-list li {
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 24px;
  background: var(--color-cool);
}
.journey-list a {
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}
.step-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--color-action-fill);
  color: var(--color-action-text);
  font-weight: 700;
  font-size: 14px;
}
.step-label {
  font-weight: 600;
  color: var(--color-ink);
}
.step-subtitle {
  margin: 0;
  color: var(--color-secondary);
  font-size: 15px;
}
.example-section {
  padding-top: 40px;
}
.example-section h2 {
  margin-bottom: 24px;
}
.example-strip {
  display: flex;
  border: 1px solid var(--color-border);
  border-radius: 8px;
  overflow: hidden;
}
.example-cell {
  flex: 1;
  padding: 24px;
}
.example-cell:first-child {
  border-right: 1px solid var(--color-border);
  background: var(--color-cool);
}
.cell-label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-secondary);
  margin-bottom: 8px;
}
.cell-text {
  margin: 0;
  font-size: 18px;
  color: var(--color-ink);
}
.example-details {
  margin-top: 16px;
  padding: 16px 24px;
  border: 1px solid var(--color-border);
  border-radius: 8px;
  background: var(--color-surface);
}
.example-details summary {
  cursor: pointer;
  font-weight: 600;
  color: var(--color-teal);
}
.example-details ol {
  padding-left: 20px;
  margin-top: 12px;
}
.example-details li {
  margin-bottom: 8px;
}
.example-cta {
  margin-top: 24px;
}
#founders {
  scroll-margin-top: 100px;
}
.founders-section {
  padding-top: 60px;
}
.founders-grid {
  display: grid;
  gap: 32px;
}
.founder-card {
  display: flex;
  gap: 32px;
  align-items: flex-start;
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 32px;
}
.founder-portrait {
  width: 160px;
  height: 160px;
  object-fit: cover;
  border-radius: 4px;
  border: 8px solid var(--color-cool);
  flex-shrink: 0;
}
.founder-body h3 { margin-bottom: 4px; }
.founder-role {
  color: var(--color-muted-blue);
  font-weight: 600;
  font-size: 16px;
  margin: 0 0 16px;
}
.founder-bio { margin-bottom: 16px; }
.founder-focus {
  list-style: none;
  padding: 0;
  margin: 0 0 20px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.founder-focus li {
  font-size: 14px;
  color: var(--color-secondary);
  background: var(--color-cool);
  padding: 4px 12px;
  border-radius: 100px;
}
.founder-links {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}
.founder-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  text-decoration: none;
  color: var(--color-teal);
  font-weight: 600;
  font-size: 15px;
}
.founder-link:hover { text-decoration: underline; }
.contact-section {
  padding-top: 60px;
  padding-bottom: 20px;
}
.contact-links {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  margin-top: 16px;
}
.contact-link {
  font-weight: 600;
}
@media (max-width: 768px) {
  .hero {
    grid-template-columns: 1fr;
  }
  .hero-map {
    order: 0;
  }
  .example-strip { flex-direction: column; }
  .example-cell:first-child { border-right: none; border-bottom: 1px solid var(--color-border); }
  .founder-card { flex-direction: column; align-items: center; text-align: center; padding: 24px; }
  .founder-portrait { width: 128px; height: 128px; }
  .founder-focus { justify-content: center; }
  .founder-links { justify-content: center; }
}
</style>
