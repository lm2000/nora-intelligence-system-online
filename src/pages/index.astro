---
import SiteLayout from '../layouts/SiteLayout.astro';
import OriginalIndex from '../components/OriginalIndex.astro';
import SourceMap from '../components/SourceMap.astro';
import { href } from '../lib/constants.mjs';
import site from '../data/site.json';
import walkthroughs from '../data/walkthroughs.json';
import atlasExample from '../data/atlas-example.json';

const firstRequestStep = walkthroughs.request[0].id;
const founders = site.founders.filter(f => f && f.name);

const indexEntries = [
  { id: 'overview', label: 'Overview', description: 'One assistant with clear service boundaries' },
  { id: 'example', label: 'Atlas example', description: 'A worked fictional fixture, question to answer' },
  { id: 'system-map', label: 'Architecture', description: 'Interactive source-grounded system map' },
  { id: 'founders', label: 'Founders', description: 'Who is building Nora SuperIntelligence Lab' },
  { id: 'contact', label: 'Contact', description: 'Discuss a role or project with Michael' }
];
---
<SiteLayout title="Nora SuperIntelligence Lab — Architecture" description="One assistant. Clear service boundaries. Explore how a knowledge assistant retrieves prepared documents, produces an answer, and keeps conversation state." path="/" customIndex={true}>
  <section class="hero hero--home" id="overview" data-index-label="Overview">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--one" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--two" aria-hidden="true"></div>
    <div class="shell hero-layout">
      <div class="hero-copy">
        <h1>{site.home.heading} {site.home.headingEmphasis}</h1>
        <p class="hero-lede">{site.home.intro}</p>
        <div class="hero-actions">
          <a class="button button--primary" href={href(`/walkthroughs/?flow=request&step=${firstRequestStep}`)}>Follow a request <span aria-hidden="true">→</span></a>
          <a class="button button--ghost" href={href('/architecture/')}>Read the architecture</a>
        </div>
        <ul class="hero-signals" aria-label="Design principles">
          <li>Single assistant</li>
          <li>Prepared knowledge</li>
          <li>Durable state</li>
          <li>Provider-flexible</li>
        </ul>
      </div>
      <OriginalIndex tagline="Nora guided portfolio" title="From overview to contact" entries={indexEntries} ariaLabel="Home navigation" />
    </div>
  </section>

  <section class="section workflow-section" id="example" data-index-label="Atlas example">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div>
          <p class="section-label">Worked example</p>
          <h2>Fictional Atlas, a grounded fixture.</h2>
        </div>
        <p>A fictional project fixture shows the path from question to answer: coordination retrieves prepared passages, then produces a plain answer with supported points and gaps.</p>
      </div>
      <div class="principle-callout atlas-callout">
        <div class="principle-mark" aria-hidden="true">Q</div>
        <div>
          <p class="section-label">Question</p>
          <h3>{atlasExample.question}</h3>
        </div>
      </div>
      <div class="principle-callout atlas-callout">
        <div class="principle-mark" aria-hidden="true">A</div>
        <div>
          <p class="section-label">Answer</p>
          <h3>{atlasExample.answer}</h3>
        </div>
      </div>
      <details class="atlas-details">
        <summary>View illustrative steps</summary>
        <ol>
          {atlasExample.steps.map(step => (
            <li><strong>{step.label}:</strong> {step.detail}</li>
          ))}
        </ol>
      </details>
    </div>
  </section>

  <section class="section workflow-section" id="system-map" data-index-label="Architecture">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div>
          <p class="section-label">System map</p>
          <h2>One assistant, separate services.</h2>
        </div>
        <p>Browser UI, Coordination, retrieval, and conversation state have distinct responsibilities. Follow a request to see how they work together.</p>
      </div>
      <figure class="diagram-figure diagram-figure--architecture">
        <SourceMap initialFocus="" />
        <figcaption class="visually-hidden">System architecture overview</figcaption>
      </figure>
    </div>
  </section>

  <section class="section foundation-section" id="founders" data-index-label="Founders">
    <div class="shell foundation-layout">
      <div class="foundation-copy">
        <p class="section-label">Founders</p>
        <h2>The person behind the lab.</h2>
        <p>Meet the founder and discuss technical leadership roles or projects.</p>
        {site.contact && (
          <a class="text-link" href={site.contact.links[0].url}>{site.contact.links[0].label} <span aria-hidden="true">→</span></a>
        )}
      </div>
      <div class="foundation-list">
        {founders.map(f => (
          <div class="founder-entry">
            <span>01</span>
            <p>
              {f.image && <img class="founder-portrait" src={href('/' + f.image)} alt={`Portrait of ${f.name}`} width="160" height="160" />}
              <strong>{f.name}</strong>{f.role ? ` — ${f.role}. ` : '. '}{f.bio}
            </p>
            {f.focus && f.focus.length > 0 && (
              <ul class="hero-signals founder-focus" aria-label="Focus areas">
                {f.focus.map(item => <li>{item}</li>)}
              </ul>
            )}
            {f.links && (
              <p class="founder-links">
                {f.links.map(l => <a class="text-link" href={l.url}>{l.label}</a>)}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  {site.contact && (
    <section class="section pilots-section" id="contact" data-index-label="Contact">
      <div class="shell">
        <div class="section-heading section-heading--split">
          <div>
            <p class="section-label">Contact</p>
            <h2>{site.contact.heading}</h2>
          </div>
          <p>{site.contact.body}</p>
        </div>
        <div class="hero-actions">
          {site.contact.links.map(l => (
            <a class="button button--primary" href={l.url}>{l.label} <span aria-hidden="true">→</span></a>
          ))}
        </div>
      </div>
    </section>
  )}
</SiteLayout>
<style>
.atlas-callout {
  margin-top: 28px;
}
.principle-mark {
  flex: 0 0 auto;
}
.atlas-details {
  margin-top: 32px;
  padding: 16px 24px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--navy-2);
}
.atlas-details summary {
  cursor: pointer;
  font-weight: 600;
  color: var(--color-muted-blue);
  min-height: 44px;
  display: flex;
  align-items: center;
}
.atlas-details ol { padding-left: 20px; margin: 12px 0; color: var(--ink-soft); }
.atlas-details li { margin-bottom: 8px; }
.founder-entry { position: relative; }
.founder-portrait {
  width: 96px;
  height: 96px;
  object-fit: cover;
  border-radius: 12px;
  border: 3px solid rgba(255, 255, 255, 0.16);
  margin-bottom: 14px;
}
.founder-focus { margin: 14px 0 0; grid-column: 2; }
.founder-links { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 18px; grid-column: 2; }
div.founder-entry > p { margin: 0; }
</style>
