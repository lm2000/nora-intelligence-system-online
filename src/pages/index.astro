---
import SiteLayout from '../layouts/SiteLayout.astro';
import OriginalIndex from '../components/OriginalIndex.astro';
import EmailAddress from '../components/EmailAddress.astro';
import { href } from '../lib/constants.mjs';
import site from '../data/site.json';
import walkthroughs from '../data/walkthroughs.json';

const firstRequestStep = walkthroughs.request[0].id;
const founder = site.founders.filter(f => f && f.name)[0];

const indexEntries = [
  { id: 'overview', label: 'Overview', description: 'The lab and its current knowledge-assistant work' },
  { id: 'example', label: 'Current work', description: 'The lab’s knowledge-assistant project' },
  { id: 'system-map', label: 'Approach', description: 'A practical way to build useful systems' },
  { id: 'founders', label: 'Founders', description: 'Michael and the work behind the lab' },
  { id: 'contact', label: 'Contact', description: 'Get in touch about roles or projects' }
];
---

<SiteLayout title="Home — Nora SuperIntelligence Lab" description="I lead Nora SuperIntelligence Lab, an independent lab building knowledge assistants and practical AI systems. The current project is a knowledge assistant." path="/" customIndex={true}>
  <section class="hero hero--home" id="overview" data-index-label="Overview">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--one" aria-hidden="true"></div>
    <div class="hero-glow hero-glow--two" aria-hidden="true"></div>
    <div class="shell hero-layout">
      <div class="hero-copy">
        <h1>{site.home.heading} {site.home.headingEmphasis}</h1>
        <p class="hero-lede">{site.home.intro}</p>
        <div class="hero-actions home-actions">
          <a class="button button--primary" href={href('/architecture/')}>Explore the architecture <span aria-hidden="true">→</span></a>
          <a class="button button--ghost" href={href(`/walkthroughs/?flow=request&step=${firstRequestStep}`)}>Follow a walkthrough <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <OriginalIndex tagline="HOME" title="Inside the lab" entries={indexEntries} ariaLabel="Home navigation" />
    </div>
  </section>

  <section class="section" id="example" data-index-label="Current work">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div>
          <p class="section-label">Current work</p>
          <h2>A knowledge assistant.</h2>
        </div>
        <p>The project explores how an assistant can work with prepared knowledge, use tools, and retain conversation state. Its public harness makes the architecture and checks available to examine.</p>
      </div>
      <div class="home-process" aria-labelledby="home-process-title">
        <h3 id="home-process-title">From question to inspectable answer.</h3>
        <ol class="home-process__flow" aria-label="Knowledge-assistant request flow">
          <li>Question</li><li>Prepared knowledge</li><li>Tools</li><li>Conversation state</li><li>Inspectable answer</li>
        </ol>
      </div>
      <div class="hero-actions home-actions">
        <a class="text-link" href={href('/architecture/')}>Architecture <span aria-hidden="true">→</span></a>
        <a class="text-link" href={href(`/walkthroughs/?flow=request&step=${firstRequestStep}`)}>Walkthroughs <span aria-hidden="true">→</span></a>
        <a class="text-link" href={href('/workflows/')}>Workflows <span aria-hidden="true">→</span></a>
        <a class="text-link" href={href('/case-study/')}>How the assistant was built <span aria-hidden="true">→</span></a>
      </div>
      <div class="case-card">
        <p class="case-card__label">Research case study</p>
        <h3 class="case-card__title">AI Harness Landscape</h3>
        <p class="case-card__summary">Compares how AI products connect knowledge, tools, durable state, and human review into useful work.</p>
        <a class="text-link" href={href('/case-studies/ai-harness-landscape/')}>Read the case study <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section foundation-section" id="system-map" data-index-label="Approach">
    <div class="shell foundation-layout">
      <div class="foundation-copy">
        <p class="section-label">Approach</p>
        <h2>A practical way to build.</h2>
        <a class="text-link" href={href('/validation/')}>See how the work is validated <span aria-hidden="true">→</span></a>
      </div>
      <div class="foundation-list" role="list">
        <div role="listitem">
          <span>01</span>
          <p><strong>Start with a concrete use case</strong> to guide what the system needs to do.</p>
        </div>
        <div role="listitem">
          <span>02</span>
          <p><strong>Keep responsibilities clear.</strong> Make each responsibility explicit so the system is easier to understand and change.</p>
        </div>
        <div role="listitem">
          <span>03</span>
          <p><strong>Make the work inspectable.</strong> Keep source, architectural decisions, and checks available for review.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section foundation-section" id="founders" data-index-label="Founders">
    <div class="shell foundation-layout">
      <div class="foundation-copy">
        <p class="section-label">Founders</p>
        <h2>The person behind the lab.</h2>
      </div>
      {founder && (
        <div class="foundation-list">
          <div class="founder-entry">
            <span>01</span>
            <p>I lead the knowledge-assistant project at Nora SuperIntelligence Lab, exploring how people, knowledge, agents, and tools can work together without losing human judgment.</p>
            <p class="founder-links"><a class="text-link" href={href('/founders/')}>More about me <span aria-hidden="true">→</span></a></p>
          </div>
        </div>
      )}
    </div>
  </section>

  {site.contact && (
    <section class="section pilots-section" id="contact" data-index-label="Contact">
      <div class="shell">
        <div class="section-heading section-heading--split">
          <div>
            <p class="section-label">Contact</p>
            <h2>Discuss a role or project.</h2>
          </div>
          <p>I’m open to technical leadership roles and AI or data-platform projects. The Founders page has the fuller profile and contact context.</p>
        </div>
        <div class="hero-actions">
          {site.contact.links.map(l => (
            <a class="button button--primary" href={l.url}>{l.label} <span aria-hidden="true">→</span></a>
          ))}
          <a class="button button--ghost" href="https://www.linkedin.com/in/michael-lvov-05a8125/">View my LinkedIn profile</a>
        </div>
        <EmailAddress />
      </div>
    </section>
  )}
</SiteLayout>

<style>
.home-actions {
  margin-top: 24px;
}
.home-actions { gap: 20px; }
.founder-entry { position: relative; }
div.founder-entry > p { margin: 0; }
.founder-links { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 18px; grid-column: 2; }

.case-card {
  margin-top: 28px;
  max-width: 720px;
  padding: 22px 22px 20px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: rgba(11, 36, 54, 0.58);
}
.case-card__label {
  margin: 0 0 10px;
  color: var(--teal);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.case-card__title {
  margin: 0 0 10px;
  color: var(--white);
  font-size: 1.35rem;
  line-height: 1.25;
}
.case-card__summary {
  margin: 0 0 14px;
  color: var(--ink-soft);
  font-size: 1rem;
  line-height: 1.6;
}

.home-process { margin-block: 28px; }
.home-process h3 { margin: 0 0 16px; font-size: 18px; }
.home-process__flow { display: flex; flex-wrap: wrap; gap: 12px 24px; padding: 0; margin: 0; list-style: none; counter-reset: request; }
.home-process__flow li { display: flex; align-items: baseline; gap: 10px; counter-increment: request; color: var(--ink-soft); }
.home-process__flow li::before { content: counter(request, decimal-leading-zero); color: var(--teal-light); font-size: 12px; font-weight: 700; }
@media (max-width: 680px) { .home-process__flow { display: grid; gap: 12px; } }
</style>
