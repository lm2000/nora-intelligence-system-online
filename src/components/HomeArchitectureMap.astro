---
import { href } from '../lib/constants.mjs';
---

<figure class="home-architecture" aria-labelledby="home-map-heading">
  <h3 id="home-map-heading">How the knowledge assistant fits together.</h3>
  <div class="home-map-scroll" role="region" aria-label="Simplified knowledge assistant architecture" tabindex="0">
    <svg class="home-map" viewBox="0 0 780 620" role="img" aria-labelledby="home-map-title home-map-description" xmlns="http://www.w3.org/2000/svg">
      <title id="home-map-title">Knowledge assistant system map</title>
      <desc id="home-map-description">CopilotKit and AG-UI reach the Deep Agents and LangGraph assistant directly. Codex and OpenClaw enter through LiteLLM and FastMCP. Retrieval MCP uses shared BGE for query encoding and reads Qdrant and prepared documents directly. Manual ingestion uses BGE for document encoding and publishes knowledge outside conversations. The assistant calls Ollama Cloud or Fireworks.ai and keeps checkpoints in PostgreSQL.</desc>
      <defs>
        <marker id="home-map-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#879ab1" />
        </marker>
      </defs>

      <text class="map-kicker" x="24" y="43">REQUEST ENTRANCES</text>
      <text class="map-kicker" x="420" y="43">SHARED ASSISTANT</text>

      <g class="map-edges" fill="none" stroke="#879ab1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" marker-end="url(#home-map-arrow)">
        <path d="M 184 109 H 400 V 158 H 420" />
        <path d="M 184 223 H 210" />
        <path d="M 382 223 H 400 V 187 H 420" />
        <path d="M 594 174 H 620" />
        <path d="M 453 227 V 320 H 111 V 360" />
        <path d="M 500 227 V 330 H 305 V 360" />
        <path d="M 547 227 V 340 H 499 V 360" />
        <path d="M 111 458 V 486 H 315 V 500" />
        <path d="M 170 458 V 472 H 542 V 500" />
        <path d="M 198 536 H 218" />
        <path d="M 412 536 H 432" />
        <path d="M 111 572 V 598 H 542 V 572" />
      </g>

      <g class="map-node map-node--client">
        <rect x="24" y="70" width="160" height="78" rx="16" />
        <text class="map-node-tag" x="42" y="92">CLIENT</text>
        <text class="map-node-title" x="42" y="116">Browser UI</text>
        <text class="map-node-detail" x="42" y="138">CopilotKit / AG-UI</text>
      </g>
      <g class="map-node map-node--client">
        <rect x="24" y="184" width="160" height="78" rx="16" />
        <text class="map-node-tag" x="42" y="206">CLIENT</text>
        <text class="map-node-title" x="42" y="230">MCP clients</text>
        <text class="map-node-detail" x="42" y="252">Codex / OpenClaw</text>
      </g>
      <g class="map-node map-node--entrance">
        <rect x="210" y="184" width="172" height="78" rx="16" />
        <text class="map-node-tag" x="228" y="206">ENTRANCE</text>
        <text class="map-node-title" x="228" y="230">MCP entrance</text>
        <text class="map-node-detail" x="228" y="252">LiteLLM → FastMCP</text>
      </g>
      <g class="map-node map-node--assistant">
        <rect x="420" y="122" width="174" height="105" rx="18" />
        <text class="map-node-tag" x="438" y="147">SERVICE</text>
        <text class="map-node-title" x="438" y="176">Assistant</text>
        <text class="map-node-detail" x="438" y="203">Deep Agents / LangGraph</text>
      </g>
      <g class="map-node map-node--result">
        <rect x="620" y="133" width="135" height="82" rx="16" />
        <text class="map-node-tag" x="638" y="156">RESULT</text>
        <text class="map-node-title" x="638" y="181">Answer</text>
        <text class="map-node-detail" x="638" y="203">Source-backed</text>
      </g>
      <g class="map-node map-node--service">
        <rect x="24" y="360" width="174" height="98" rx="16" />
        <text class="map-node-tag" x="42" y="384">SERVICE</text>
        <text class="map-node-title" x="42" y="411">Retrieval MCP</text>
        <text class="map-node-detail" x="42" y="437">Search / read</text>
      </g>
      <g class="map-node map-node--provider">
        <rect x="218" y="360" width="174" height="98" rx="16" />
        <text class="map-node-tag" x="236" y="384">PROVIDER</text>
        <text class="map-node-title" x="236" y="411">Model providers</text>
        <text class="map-node-detail" x="236" y="430">Ollama Cloud /</text>
        <text class="map-node-detail" x="236" y="447">Fireworks.ai</text>
      </g>
      <g class="map-node map-node--storage">
        <rect x="412" y="360" width="174" height="98" rx="16" />
        <text class="map-node-tag" x="430" y="384">STORAGE</text>
        <text class="map-node-title" x="430" y="411">PostgreSQL</text>
        <text class="map-node-detail" x="430" y="437">LangGraph checkpoints</text>
      </g>
      <g class="map-node map-node--manual">
        <rect x="24" y="500" width="174" height="72" rx="16" />
        <text class="map-node-tag" x="42" y="520">MANUAL JOB</text>
        <text class="map-node-title" x="42" y="543">Manual ingestion</text>
        <text class="map-node-detail" x="42" y="562">Four operator jobs</text>
      </g>
      <g class="map-node map-node--service">
        <rect x="218" y="500" width="194" height="72" rx="16" />
        <text class="map-node-tag" x="236" y="520">SERVICE</text>
        <text class="map-node-title" x="236" y="543">Shared BGE</text>
        <text class="map-node-detail" x="236" y="562">Query + document encoding</text>
      </g>
      <g class="map-node map-node--storage">
        <rect x="432" y="500" width="220" height="72" rx="16" />
        <text class="map-node-tag" x="450" y="520">STORAGE</text>
        <text class="map-node-title" x="450" y="543">Qdrant + documents</text>
        <text class="map-node-detail" x="450" y="562">Index + prepared text</text>
      </g>
    </svg>
  </div>
  <figcaption>
    <p>A compact view of the published Harness architecture. Browser requests enter directly; MCP clients use the gateway. Manual ingestion prepares knowledge outside the conversation.</p>
    <a href={href('/architecture/#system-map')}>Explore the full architecture <span aria-hidden="true">→</span></a>
  </figcaption>
</figure>

<style>
  .home-architecture { width: min(100%, 760px); margin: 32px 0; }
  .home-architecture h3 { margin: 0 0 18px; font-size: 1.2rem; color: var(--ink); }
  .home-map-scroll { overflow-x: auto; border: 1px solid #d2ddea; border-radius: 18px; background: #fff; }
  .home-map-scroll:focus-visible { outline: 3px solid var(--teal-light); outline-offset: 3px; }
  .home-map { display: block; width: 100%; min-width: 760px; height: auto; font-family: inherit; }
  .map-kicker { fill: #52647c; font-size: 11px; font-weight: 700; letter-spacing: .12em; }
  .map-node rect { fill: #f7f9fc; stroke: #7d8ca3; stroke-width: 1.7; }
  .map-node--entrance rect { fill: #f4f0fc; stroke: #7962bd; }
  .map-node--assistant rect, .map-node--service rect { fill: #eff6ff; stroke: #3778b9; }
  .map-node--result rect, .map-node--storage rect { fill: #edf9f5; stroke: #21836c; }
  .map-node--manual rect { fill: #fff6e8; stroke: #b9842f; }
  .map-node-title { fill: #182d48; font-size: 16px; font-weight: 650; }
  .map-node-detail { fill: #53647d; font-size: 12px; }
  .map-node-tag { fill: #52647c; font-size: 9px; font-weight: 700; letter-spacing: .15em; }
  .map-node--entrance .map-node-tag { fill: #7962bd; }
  .map-node--assistant .map-node-tag, .map-node--service .map-node-tag { fill: #3778b9; }
  .map-node--result .map-node-tag, .map-node--storage .map-node-tag { fill: #21836c; }
  .map-node--manual .map-node-tag { fill: #b9842f; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 24px; margin-top: 14px; color: var(--ink-soft); font-size: 14px; line-height: 1.6; }
  figcaption p { max-width: 72ch; margin: 0; }
  figcaption a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; white-space: nowrap; }
  @media (max-width: 760px) { .home-architecture::after { content: 'Scroll sideways to explore the map'; display: block; margin-top: 8px; color: var(--ink-soft); font-size: 13px; } }
</style>
