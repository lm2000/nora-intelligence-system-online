---
import { href, SITE_NAME } from '../lib/constants.mjs';

const pages = [
  { label: 'Home', path: '/' },
  { label: 'Architecture', path: '/architecture/' },
  { label: 'Walkthroughs', path: '/walkthroughs/' },
  { label: 'Use cases', path: '/use-cases/' },
  { label: 'Founders', path: '/founders/' },
  { label: 'Decisions', path: '/decisions/' },
  { label: 'Validation', path: '/validation/' },
  { label: 'Reproduce', path: '/reproduce/' },
  { label: 'Workflows', path: '/workflows/' },
  { label: 'How the assistant was built', path: '/case-study/' }
];
---
<footer class="site-footer">
  <div class="shell footer-wrap">
    <a class="brand brand--footer" href={href('/')} aria-label={SITE_NAME + ' home'}>
      <img src={href('/images/nora-mark.svg')} width="32" height="32" alt="" />
      <span>Nora <strong>SuperIntelligence Lab</strong></span>
    </a>
    <p>An independent lab building knowledge assistants and practical AI systems.</p>
    <div class="footer-links">
      {pages.map(p => <a href={href(p.path)}>{p.label}</a>)}
      <a class="footer-contact" href={href('/use-cases/#workflow-contact')}>Contact</a>
      <a href="https://github.com/lm2000/nora-ai-knowledge-agent-harness-public">Public harness</a>
      <a href="https://github.com/lm2000/nora-intelligence-system-online">Website source</a>
      <a href="https://github.com/lm2000/nora-intelligence-system-online/blob/main/LICENSE">Apache 2.0</a>
    </div>
  </div>
</footer>
<style>
.footer-links {
  max-width: 420px;
  flex-wrap: wrap;
  align-items: center;
}
.footer-contact { display: inline-flex; align-items: center; min-height: 44px; }
</style>
