---
---

<details class="page-index" hidden>
  <summary>On this page</summary>
  <nav class="page-index-nav" aria-label="On this page">
    <ol class="page-index-list"></ol>
  </nav>
</details>

<style>
:global(.page-index) {
  display: none;
}

:global(.page-index[hidden]) {
  display: none !important;
}

:global(.page-index summary) {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 12px 16px;
  font-weight: 600;
  color: var(--ink);
  cursor: pointer;
  list-style: none;
}
:global(.page-index summary)::after {
  content: '';
  display: inline-block;
  margin-left: auto;
  border: solid currentColor;
  border-width: 0 2px 2px 0;
  padding: 3px;
  transform: rotate(45deg);
}
:global(.page-index[open] summary)::after {
  transform: rotate(-135deg);
}
:global(.page-index summary)::-webkit-details-marker {
  display: none;
}

@media (max-width: 1080px) {
  :global(.page-index:not([hidden])) {
    display: block;
    position: static;
    margin: 16px auto;
    width: min(calc(100% - 30px), var(--shell));
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--navy-2);
  }
}

@media (min-width: 1081px) {
  :global(.page-index:not([hidden])) {
    display: block;
    position: fixed;
    top: calc(var(--header-height, 80px) + 16px);
    right: 20px;
    z-index: 30;
    width: 170px;
    max-height: calc(100dvh - var(--header-height, 80px) - 32px);
    overflow-y: auto;
    background: var(--navy-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 12px;
    box-shadow: var(--shadow-soft, 0 12px 30px rgba(0, 0, 0, 0.15));
  }
  :global(.page-index summary) {
    display: none;
  }
}

:global(.page-index-list) {
  list-style: none;
  margin: 0;
  padding: 0;
  counter-reset: pageindex;
}

:global(.page-index-item) {
  counter-increment: pageindex;
}

:global(.page-index-item a) {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  padding: 8px 4px;
  color: var(--ink-soft);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  line-height: 1.3;
}

:global(.page-index-item a)::before {
  content: counter(pageindex, decimal-leading-zero);
  flex: 0 0 auto;
  font-size: 12px;
  font-weight: 700;
  color: var(--teal);
  letter-spacing: 0.05em;
}

:global(.page-index-item a:hover),
:global(.page-index-item a:focus-visible) {
  color: var(--ink);
}

:global(.page-index-item a[aria-current="location"]) {
  color: var(--teal);
}

@media (max-width: 1080px) {
  :global(.page-index-item a) {
    border-bottom: 1px solid var(--line);
    padding: 10px 16px;
  }
  :global(.page-index-item:last-child a) {
    border-bottom: none;
  }
}
</style>

<script>
function initPageIndex(): void {
  const container = document.querySelector<HTMLElement>('.page-index');
  if (!container || container.classList.contains('initialized')) return;
  container.classList.add('initialized');

  const desktop = window.matchMedia('(min-width: 1081px)');
  const nav = container.querySelector('.page-index-list');
  if (!nav) return;

  const toggle = (): void => {
    if (!container.hasAttribute('hidden')) {
      if (desktop.matches) {
        container.setAttribute('open', '');
      } else {
        container.removeAttribute('open');
      }
    }
  };
  desktop.addEventListener('change', toggle);

  const sections: Array<{ id: string; el: HTMLElement }> = [];
  const mainRoot = document.querySelector('main');
  if (!mainRoot) return;

  const isHidden = (el: HTMLElement): boolean =>
    Boolean(el.hidden) || el.offsetParent === null;

  const insideExcluded = (el: HTMLElement): boolean =>
    !!el.closest('figure, details, nav, [hidden]');

  const slugify = (text: string): string =>
    text.trim().toLowerCase().replace(/[^\w]+/g, '-').replace(/(^-|-$)/g, '') || 'section';

  const uniqueId = (base: string): string => {
    let id = base;
    let attempt = 2;
    while (document.getElementById(id)) {
      id = `${base}-${attempt}`;
      attempt++;
    }
    return id;
  };

  mainRoot.querySelectorAll<HTMLElement>('h1, h2').forEach((h) => {
    if (insideExcluded(h) || isHidden(h)) return;
    const rawText = (h.textContent || '').trim();
    if (!rawText || rawText === 'Reference') return;

    const parentSection = h.closest('section[id]');
    let id: string;
    if (
      parentSection instanceof HTMLElement &&
      parentSection.id &&
      parentSection.querySelector(':scope > h1, :scope > h2') === h
    ) {
      id = parentSection.id;
    } else {
      id = h.id || uniqueId(slugify(rawText));
    }
    if (!h.id && id !== parentSection?.id) h.id = id;

    const label = h.tagName === 'H1' ? 'Overview' : (parentSection?.getAttribute('data-index-label') || rawText.replace(/\.$/, ''));
    if (!label) return;

    const li = document.createElement('li');
    li.className = 'page-index-item';
    const a = document.createElement('a');
    a.href = `#${id}`;
    a.textContent = label;
    a.addEventListener('click', () => { if (!desktop.matches) container.removeAttribute('open'); });
    li.appendChild(a);
    nav.appendChild(li);
    sections.push({ id, el: h });
  });

  if (sections.length === 0) return;
  container.removeAttribute('hidden');
  toggle();

  let frame: number | undefined;
  const update = (): void => {
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = undefined;
      const nearBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 100;
      const header = document.querySelector('header');
      const line = Math.ceil(header ? header.getBoundingClientRect().height : 80) + 26;
      let current = sections[0].id;
      for (const { id, el } of sections) {
        if (el.getBoundingClientRect().top <= line) current = id;
        else break;
      }
      const target = nearBottom ? sections[sections.length - 1].id : current;
      nav.querySelectorAll('a').forEach((a) => {
        const href = a.getAttribute('href') ?? '';
        if (href === `#${target}`) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    });
  };

  window.addEventListener('scroll', update, { passive: true });
  update();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initPageIndex);
} else {
  initPageIndex();
}
</script>
