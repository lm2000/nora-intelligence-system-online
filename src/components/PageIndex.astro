---
---

<details class="page-index" hidden>
  <summary>On this page</summary>
  <nav class="page-index-nav" aria-label="On this page">
    <ol class="page-index-list"></ol>
  </nav>
</details>

<style>
:global(.page-index) {
  display: none;
}

:global(.page-index[hidden]) {
  display: none !important;
}

@media (min-width: 1280px) {
  :global(.page-index:not([hidden])) {
    display: block;
    position: fixed;
    top: 50%;
    right: 20px;
    transform: translateY(-50%);
    z-index: 30;
    width: 180px;
    max-height: 65vh;
    overflow-y: auto;
    background: var(--color-cool);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 14px);
    padding: 16px;
    box-shadow: var(--shadow-soft, 0 12px 30px rgba(0, 0, 0, 0.15));
  }
}

:global(.page-index summary) {
  display: none;
}

@media (max-width: 1279px) {
  :global(.page-index:not([hidden])) {
    display: block;
    position: static;
    margin: 16px 20px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-cool);
  }
  :global(.page-index summary) {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 12px 16px;
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
  }
  :global(.page-index summary)::after {
    content: '';
    display: inline-block;
    margin-left: auto;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    padding: 3px;
    transform: rotate(45deg);
  }
  :global(.page-index[open] summary)::after {
    transform: rotate(-135deg);
  }
  :global(.page-index summary)::-webkit-details-marker {
    display: none;
  }
}

:global(.page-index-nav) {
  max-height: inherit;
}

:global(.page-index-list) {
  list-style: none;
  margin: 0;
  padding: 0;
}

:global(.page-index-item a) {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 8px 0;
  color: var(--color-secondary);
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  text-decoration: none;
  line-height: 1.3;
}

@media (min-width: 1280px) {
  :global(.page-index-item a) {
    justify-content: flex-end;
    text-align: right;
    gap: 8px;
  }
  :global(.page-index-item a)::after {
    content: '';
    display: block;
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    transition: all 160ms ease;
  }
  :global(.page-index-item a[aria-current="location"]) {
    color: var(--color-muted-blue);
  }
  :global(.page-index-item a[aria-current="location"])::after {
    border-color: var(--color-muted-blue);
    background: var(--color-muted-blue);
    transform: scale(1.3);
  }
}

@media (max-width: 1279px) {
  :global(.page-index-item a) {
    border-bottom: 1px solid var(--color-border);
  }
  :global(.page-index-item:last-child a) {
    border-bottom: none;
  }
}
</style>

<script>
function initPageIndex(): void {
  const container = document.querySelector('.page-index');
  if (!container || container.classList.contains('initialized')) return;
  container.classList.add('initialized');

  const desktop = window.matchMedia('(min-width: 1280px)');
  const nav = container.querySelector('.page-index-list');
  if (!nav) return;

  const toggle = (): void => {
    if (desktop.matches && !container.hasAttribute('hidden')) {
      container.setAttribute('open', '');
    } else {
      container.removeAttribute('open');
    }
  };
  desktop.addEventListener('change', toggle);

  const sections: Array<{ id: string; el: HTMLElement }> = [];
  const mainRoot = document.querySelector('main');
  if (!mainRoot) return;

  const isHidden = (el: HTMLElement): boolean =>
    Boolean(el.hidden) || el.offsetParent === null;

  const insideExcluded = (el: HTMLElement): boolean =>
    !!el.closest('figure, details, nav, [hidden]');

  const slugify = (text: string): string =>
    text.trim().toLowerCase().replace(/[^\w]+/g, '-').replace(/(^-|-$)/g, '') || 'section';

  const uniqueId = (base: string): string => {
    let id = base;
    let attempt = 2;
    while (document.getElementById(id)) {
      id = `${base}-${attempt}`;
      attempt++;
    }
    return id;
  };

  mainRoot.querySelectorAll<HTMLElement>('h1, h2').forEach((h) => {
    if (insideExcluded(h) || isHidden(h)) return;
    const rawText = (h.textContent || '').trim();
    if (!rawText || rawText === 'Reference') return;

    const parentSection = h.closest('section[id]');
    let id: string;
    if (
      parentSection instanceof HTMLElement &&
      parentSection.id &&
      parentSection.querySelector(':scope > h1, :scope > h2') === h
    ) {
      id = parentSection.id;
    } else {
      id = h.id || uniqueId(slugify(rawText));
    }
    if (!h.id && id !== parentSection?.id) h.id = id;

    const label = h.tagName === 'H1' ? 'Overview' : (parentSection?.getAttribute('data-index-label') || rawText.replace(/\.$/, ''));
    if (!label) return;

    const li = document.createElement('li');
    li.className = 'page-index-item';
    const a = document.createElement('a');
    a.href = `#${id}`;
    a.textContent = label;
    a.addEventListener('click', () => { if (!desktop.matches) container.removeAttribute('open'); });
    li.appendChild(a);
    nav.appendChild(li);
    sections.push({ id, el: h });
  });

  if (sections.length < 3) return;
  container.removeAttribute('hidden');
  toggle();

  let frame: number | undefined;
  const update = (): void => {
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = undefined;
      const nearBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 100;
      const current = sections.reduce((acc, { id, el }) => {
        if (el.getBoundingClientRect().top <= (document.querySelector('header')?.getBoundingClientRect().height || 80) + 26 && !acc.done) acc.id = id;
        return acc;
      }, { id: sections[0].id, done: false }).id;
      const target = nearBottom ? sections[sections.length - 1].id : current;
      nav.querySelectorAll('a').forEach((a) => {
        const href = a.getAttribute('href') ?? '';
        if (href === `#${target}`) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    });
  };

  window.addEventListener('scroll', update, { passive: true });
  update();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initPageIndex);
} else {
  initPageIndex();
}
</script>
