---

interface Entry {
  id: string;
  label: string;
  description: string;
}

interface Props {
  title?: string;
  tagline?: string;
  entries: Entry[];
  ariaLabel?: string;
  grouped?: boolean;
}

const { title, tagline, entries, ariaLabel = 'Page navigation', grouped = false } = Astro.props;
---
<details class="contents-disclosure" open>
  <summary>On this page</summary>
  <aside class="orchestration-card orchestration-card--nav" data-orchestration-nav data-grouped-index={grouped ? 'true' : undefined} aria-label={ariaLabel}>
    {tagline && <div class="card-kicker">{tagline}</div>}
    {title && <h2>{title}</h2>}
    <ol class="mini-flow">
      {entries.map((entry, i) => (
        <li>
          <span>{String(i + 1).padStart(2, '0')}</span>
          <div>
            <a href={`#${entry.id}`}>
              <strong>{entry.label}</strong>
              <small>{entry.description}</small>
            </a>
          </div>
        </li>
      ))}
    </ol>
    <div class="loop-line"><span></span><em>Each section connects to the next</em></div>
  </aside>
</details>

<script is:inline>
(function () {
  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function initNav(nav) {
    if (nav.getAttribute('data-onav-init')) return;
    nav.setAttribute('data-onav-init', '1');

    var disclosure = nav.closest('.contents-disclosure');
    var hero = nav.closest('.hero');
    if (!hero) return;

    var links = Array.prototype.slice.call(nav.querySelectorAll("a[href^='#']"));
    var sections = [];
    for (var i = 0; i < links.length; i++) {
      var link = links[i];
      var id = (link.getAttribute('href') || '').slice(1);
      var section = id ? document.getElementById(id) : null;
      if (section) sections.push({ link: link, section: section });
    }
    if (!sections.length) return;

    var desktop = window.matchMedia('(min-width: 1081px)');

    if (disclosure) {
      var applyDisclosure = function () {
        if (desktop.matches) {
          disclosure.setAttribute('open', '');
          if (!nav.classList.contains('is-docked')) {
            disclosure.style.minHeight = Math.ceil(nav.getBoundingClientRect().height) + 'px';
          }
        } else {
          disclosure.removeAttribute('open');
          disclosure.style.minHeight = '';
        }
      };
      applyDisclosure();
      if (typeof desktop.addEventListener === 'function') {
        desktop.addEventListener('change', applyDisclosure);
      }
    }

    function keepActiveVisible() {
      if (!nav.classList.contains('is-docked')) return;
      var list = nav.querySelector('.mini-flow');
      var active = nav.querySelector('a[aria-current="location"]');
      if (!list || !active) return;
      var row = active.closest('li').getBoundingClientRect();
      var bounds = list.getBoundingClientRect();
      if (row.top < bounds.top) list.scrollTop += row.top - bounds.top;
      else if (row.bottom > bounds.bottom) list.scrollTop += row.bottom - bounds.bottom;
    }

    function activate(id) {
      for (var j = 0; j < sections.length; j++) {
        if (sections[j].section.id === id) {
          sections[j].link.setAttribute('aria-current', 'location');
        } else {
          sections[j].link.removeAttribute('aria-current');
        }
      }
      keepActiveVisible();
    }

    var navigationToken = 0;
    var jumping = false;
    var destinationY = null;

    function finishJump() {
      if (jumping && destinationY !== null && Math.abs(window.scrollY - destinationY) <= 2) {
        jumping = false;
        destinationY = null;
      }
    }

    function cancelJump() {
      navigationToken++;
      jumping = false;
      destinationY = null;
      update();
      dock();
    }

    // Synchronous dock — used on init and from deferred dock()
    function syncDock() {
      finishJump();
      if (jumping) return;
      if (hero.getBoundingClientRect().height === 0) return;
      var shouldDock = desktop.matches && window.scrollY > hero.offsetHeight - 150;
      nav.classList.toggle('is-docked', shouldDock);
      document.documentElement.classList.toggle('has-docked-orchestration', shouldDock);
      if (disclosure) {
        if (desktop.matches && !shouldDock) {
          disclosure.style.minHeight = Math.ceil(nav.getBoundingClientRect().height) + 'px';
        } else if (!desktop.matches) {
          disclosure.style.minHeight = '';
        }
      }
      keepActiveVisible();
    }

    // Force dock state synchronously based on where the target lives,
    // so the content gutter reflows BEFORE we measure the scroll destination.
    function forceDockForTarget(target) {
      var targetTop = target.getBoundingClientRect().top + window.scrollY;
      var shouldDock = desktop.matches && targetTop > hero.offsetHeight - 150;
      nav.classList.toggle('is-docked', shouldDock);
      document.documentElement.classList.toggle('has-docked-orchestration', shouldDock);
      if (disclosure && desktop.matches && !shouldDock) {
        disclosure.style.minHeight = Math.ceil(nav.getBoundingClientRect().height) + 'px';
      }
      keepActiveVisible();
    }

    var frame;
    function update() {
      if (frame) return;
      frame = requestAnimationFrame(function () {
        frame = undefined;
        var header = document.querySelector('header');
        var line = Math.ceil(header ? header.getBoundingClientRect().height : 86) + 26;
        var doc = document.documentElement;
        var nearBottom = window.innerHeight + window.scrollY >= doc.scrollHeight - 120;
        var current = sections[0].section.id;
        if (nav.hasAttribute('data-grouped-index')) {
          var selectedId = window.location.hash.slice(1);
          for (var g = 0; g < sections.length; g++) {
            var groupRect = sections[g].section.getBoundingClientRect();
            if (sections[g].section.id === selectedId && groupRect.bottom > line && groupRect.top < window.innerHeight) {
              activate(selectedId);
              return;
            }
          }
          var overviewRect = sections[0].section.getBoundingClientRect();
          activate(overviewRect.bottom > line ? sections[0].section.id : '');
          return;
        }
        for (var k = 0; k < sections.length; k++) {
          if (sections[k].section.getBoundingClientRect().top <= line) {
            current = sections[k].section.id;
          } else {
            break;
          }
        }
        if (nearBottom && document.querySelector('.founder-profile')) {
          var hashId = (window.location.hash || '').slice(1);
          if (hashId) {
            for (var h = 0; h < sections.length; h++) {
              if (sections[h].section.id === hashId) {
                var rect = sections[h].section.getBoundingClientRect();
                if (rect.top >= line && rect.top < window.innerHeight) {
                  activate(hashId);
                  return;
                }
                break;
              }
            }
          }
        }
        activate(nearBottom ? sections[sections.length - 1].section.id : current);
      });
    }

    var dockFrame;
    function dock() {
      if (dockFrame) return;
      dockFrame = requestAnimationFrame(function () {
        dockFrame = undefined;
        syncDock();
      });
    }

    // Core fix: force dock → bounded rAF settle → scrollIntoView → activate
    function navigateTo(id, pushState) {
      var target = null;
      for (var i = 0; i < sections.length; i++) {
        if (sections[i].section.id === id) {
          target = sections[i].section;
          break;
        }
      }
      if (!target) return;

      var token = ++navigationToken;
      jumping = true;
      destinationY = null;
      // 1. Force matching desktop dock state synchronously
      forceDockForTarget(target);

      // 2. Bounded rAF settlement — let layout reflow from dock change
      var framesLeft = 2;
      function settle() {
        if (token !== navigationToken) return;
        framesLeft--;
        if (framesLeft > 0) {
          requestAnimationFrame(settle);
          return;
        }
        // 3. Scroll using settled positions; CSS scroll-margin-top offsets header
        var margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
        destinationY = Math.max(0, Math.min(
          target.getBoundingClientRect().top + window.scrollY - margin,
          document.documentElement.scrollHeight - window.innerHeight
        ));
        var behavior = reducedMotion.matches ? 'instant' : 'smooth';
        target.scrollIntoView({ behavior: behavior, block: 'start' });
        // 4. Select target and update active after dock
        activate(id);
        requestAnimationFrame(function () { finishJump(); dock(); update(); });
        if (pushState && window.location.hash !== '#' + id) {
          history.pushState(null, '', '#' + id);
        }
      }
      requestAnimationFrame(settle);
    }

    // Link click handlers — intercept only unmodified primary clicks
    for (var c = 0; c < links.length; c++) {
      (function (lnk) {
        lnk.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var href = lnk.getAttribute('href') || '';
          var id = href.slice(1);
          if (!id) return;
          var hasSection = false;
          for (var s = 0; s < sections.length; s++) {
            if (sections[s].section.id === id) { hasSection = true; break; }
          }
          if (!hasSection) return;
          e.preventDefault();
          if (!desktop.matches && disclosure) {
            disclosure.removeAttribute('open');
          }
          navigateTo(id, true);
        });
      })(links[c]);
    }

    // Hashchange — back/forward and deep-link navigation
    function onHashChange() {
      cancelJump();
      var id = window.location.hash.slice(1);
      if (!id) {
        update();
        return;
      }
      for (var i = 0; i < sections.length; i++) {
        if (sections[i].section.id === id) {
          navigateTo(id, false);
          return;
        }
      }
      update();
    }
    window.addEventListener('hashchange', onHashChange);

    // Initial URL fragment — bounded font/layout readiness, not perpetual observer
    function handleInitialHash() {
      var id = window.location.hash.slice(1);
      if (!id) return;
      var found = false;
      for (var i = 0; i < sections.length; i++) {
        if (sections[i].section.id === id) { found = true; break; }
      }
      if (!found) return;

      var token = navigationToken;
      var loaded = document.readyState === 'complete' ? Promise.resolve() :
        new Promise(function (resolve) { window.addEventListener('load', resolve, { once: true }); });
      var fonts = document.fonts ? document.fonts.ready : Promise.resolve();
      Promise.all([loaded, fonts]).then(function () {
        if (token === navigationToken && window.location.hash.slice(1) === id) navigateTo(id, false);
      });
    }

    window.addEventListener('wheel', cancelJump, { passive: true });
    window.addEventListener('touchstart', cancelJump, { passive: true });
    window.addEventListener('keydown', function (event) {
      if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].indexOf(event.key) !== -1) cancelJump();
    });
    document.addEventListener('scrollend', function () { finishJump(); dock(); update(); });

    window.addEventListener('scroll', function () { update(); dock(); }, { passive: true });
    window.addEventListener('resize', cancelJump, { passive: true });

    syncDock();
    update();
    handleInitialHash();
  }

  function initAll() {
    var navs = document.querySelectorAll('[data-orchestration-nav]');
    for (var i = 0; i < navs.length; i++) initNav(navs[i]);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
})();
</script>
