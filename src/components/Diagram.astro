---
import { href } from '../lib/constants.mjs';
import detailOverrides from '../data/diagram-details.json';
interface Props {
  previewSrc: string;
  htmlUrl?: string;
  gifUrl?: string;
  sourcePath?: string;
  alt: string;
  caption?: string;
  title?: string;
  purpose?: string;
  showTitle?: boolean;
}

const { previewSrc, htmlUrl, alt, caption, title, purpose, showTitle = true } = Astro.props;

const base = (previewSrc.split('/').pop() || '')
  .replace('-preview.svg', '')
  .replace(/\-/g, ' ')
  .replace(/^\w/, (c) => c.toUpperCase());
const derivedTitle = title || base;

const files = import.meta.glob('../../public/diagrams/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

let svgString = '';
let details: Record<string, { label: string; detail: string }> = {};

if (htmlUrl) {
  const basename = htmlUrl.split('/').pop();
  if (basename && files[`../../public/diagrams/${basename}`]) {
    const rawHtml = files[`../../public/diagrams/${basename}`] as string;
    const svgMatch = rawHtml.match(/<svg[\s\S]*?<\/svg>/i);
    if (svgMatch) svgString = svgMatch[0];
    const detailsMatch = rawHtml.match(/const details\s*=\s*(\{[\s\S]*?\});\s*let playing/);
    if (detailsMatch) {
      try {
        details = JSON.parse(detailsMatch[1]) as Record<string, { label: string; detail: string }>;
      } catch (e) {
        details = {};
      }
    }
  }
}

svgString = svgString
  .replace(/\srole="button"/g, '')
  .replace(/\stabindex="0"/g, '')
  .replace(/\saria-pressed="[^"]*"/g, '');

const keys = Object.keys(details);
const overrides = (detailOverrides as Record<string, Record<string, string>>)[htmlUrl?.split('/').pop() || ''] || {};
for (const key of keys) {
  if (overrides[key]) details[key].detail = overrides[key];
}
const isInteractive = keys.length > 0 && svgString.length > 0;
const detailsJson = JSON.stringify(details).replace(/</g, '\\u003c');
---

<figure class="diagram" aria-label={derivedTitle}>
  {(showTitle || purpose) && <div class="diagram-header">
    {showTitle && <h3 class="diagram-title">{derivedTitle}</h3>}
    {purpose && <p class="diagram-purpose">{purpose}</p>}
  </div>}

  {isInteractive ? (
    <interactive-diagram>
      <div class="diagram-interactive" data-diagram-interactive>
        <div class="diagram-viewport" data-diagram-viewport>
          <div class="diagram-scroll-area" data-diagram-scroll-area>
            <div class="diagram-svg-host" data-diagram-svg-host set:html={svgString}></div>
          </div>
          <p class="diagram-swipe-hint" aria-hidden="true">Swipe to explore</p>
          <button type="button" class="diagram-motion" data-diagram-motion aria-pressed="true" hidden>
            Pause motion
          </button>
        </div>

        <div class="diagram-detail-area">
          <p class="diagram-hint">Select a node to explore its connections.</p>
          <div class="diagram-selection-detail" aria-live="polite">
            <p class="diagram-detail-label" data-diagram-detail-label></p>
            <p class="diagram-detail-text" data-diagram-detail-text></p>
          </div>
        </div>

        <details class="diagram-fallback">
          <summary>View all component details</summary>
          <ul class="diagram-fallback-list">
            {keys.map((k) => (
              <li><strong>{details[k].label}:</strong> {details[k].detail}</li>
            ))}
          </ul>
        </details>

        <script type="application/json" data-diagram-details set:html={detailsJson}></script>
      </div>
    </interactive-diagram>
  ) : (
    <div class="diagram-static-wrapper">
      <img src={href(previewSrc)} alt={alt} loading="lazy" />
    </div>
  )}

  {caption && <figcaption><p class="caption-text">{caption}</p></figcaption>}
</figure>

<style>
.diagram { margin: 0; }
.diagram-header { margin-bottom: 20px; }
.diagram-title {
  font-family: inherit;
  font-weight: 700;
  font-size: 24px;
  color: var(--color-ink);
  margin: 0 0 8px;
}
.diagram-purpose {
  margin: 0;
  max-width: 70ch;
  font-size: 15px;
  color: var(--color-secondary);
}

interactive-diagram { display: block; }
.diagram-interactive { display: flex; flex-direction: column; gap: 16px; }

.diagram-viewport {
  position: relative;
  padding: 0 0 64px;
}
.diagram-scroll-area {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  display: flex;
  justify-content: center;
}
.diagram-svg-host { width: 100%; background: #fff; border-radius: 8px; }
.diagram-swipe-hint { display: none; text-align: center; font-size: 13px; color: var(--color-secondary); margin: 8px 0 0; }
.diagram-static-wrapper { width: 100%; }
.diagram-static-wrapper img { width: 100%; max-width: 100%; height: auto; display: block; }

.diagram-motion {
  position: absolute;
  bottom: 16px;
  right: 16px;
  z-index: 10;
  padding: 6px 12px;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  background: var(--color-surface);
  color: var(--color-secondary);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  min-height: 44px;
  opacity: 0.8;
}
.diagram-motion:hover { background: var(--color-cool); opacity: 1; }
.diagram-motion:focus-visible {
  outline: 2px solid var(--color-accent, #075973);
  outline-offset: 2px;
  opacity: 1;
}

.diagram-detail-area {
  border-top: 1px solid var(--color-border);
  padding: 16px 0;
  min-height: 80px;
}
.diagram-hint { margin: 0; font-size: 15px; color: var(--color-secondary); font-style: italic; }
.diagram-selection-detail { display: none; }
.diagram-detail-label { margin: 0 0 4px; font-weight: 700; color: var(--color-ink); }
.diagram-detail-text { margin: 0; font-size: 15px; color: var(--color-body); }
.diagram-detail-area.has-selection .diagram-hint { display: none; }
.diagram-detail-area.has-selection .diagram-selection-detail { display: block; }

.diagram-fallback { margin-top: 4px; }
.diagram-fallback summary { cursor: pointer; font-size: 14px; color: var(--color-secondary); }
.diagram-fallback-list { list-style: none; padding: 16px 0 0; margin: 0; display: grid; gap: 12px; }
.diagram-fallback-list li { font-size: 15px; color: var(--color-body); max-width: 80ch; }
.diagram-fallback-list strong { color: var(--color-ink); }

figcaption { margin-top: 16px; }
.caption-text { color: var(--color-secondary); font-size: 15px; margin: 0; }

@media (max-width: 768px) {
  .diagram-scroll-area { justify-content: flex-start; }
  .diagram-svg-host { min-width: 900px; }
  .diagram-swipe-hint { display: block; }
}
</style>

<script>
class InteractiveDiagram extends HTMLElement {
  private observers: IntersectionObserver[] = [];
  private rafId: number | null = null;
  private mediaQuery: MediaQueryList | null = null;
  private motionEnabled = true;
  private selectedId: string | null = null;
  private inViewport = false;

  private svg: SVGSVGElement | null = null;
  private detailArea: HTMLElement | null = null;
  private detailLabel: HTMLElement | null = null;
  private detailText: HTMLElement | null = null;
  private motionBtn: HTMLButtonElement | null = null;
  private scrollArea: HTMLElement | null = null;
  private viewport: HTMLElement | null = null;
  private fallback: HTMLDetailsElement | null = null;
  private nodes: SVGGElement[] = [];
  private edges: SVGGElement[] = [];
  private pulses: SVGCircleElement[] = [];
  private details: Record<string, { label: string; detail: string }> = {};

  private boundKeydownHandler: (e: KeyboardEvent) => void;
  private boundVisibilityHandler: () => void;
  private boundMotionChangeHandler: (e: MediaQueryListEvent) => void;

  constructor() {
    super();
    this.boundKeydownHandler = this.handleKeydown.bind(this);
    this.boundVisibilityHandler = this.handleVisibilityChange.bind(this);
    this.boundMotionChangeHandler = this.handleMotionPreferenceChange.bind(this);
  }

  connectedCallback(): void {
    if (this.svg) {
      this.mediaQuery?.addEventListener('change', this.boundMotionChangeHandler);
      this.motionEnabled = !this.mediaQuery?.matches;
      this.updateMotionButton();
      this.startLifecycle();
    }
    else this.initialize();
  }

  disconnectedCallback(): void {
    this.stopLifecycle();
  }

  private initialize(): void {
    const container = this.querySelector<HTMLElement>('[data-diagram-interactive]');
    const host = this.querySelector<HTMLElement>('[data-diagram-svg-host]');
    const detailsScript = this.querySelector<HTMLScriptElement>('script[data-diagram-details]');

    if (!container || !host || !detailsScript) return;

    try {
      this.details = JSON.parse(detailsScript.textContent || '{}');
    } catch (e) {
      return;
    }

    const svg = host.querySelector<SVGSVGElement>('svg');
    if (!svg) return;
    this.svg = svg;

    this.detailArea = this.querySelector<HTMLElement>('.diagram-detail-area');
    this.detailLabel = this.querySelector<HTMLElement>('[data-diagram-detail-label]');
    this.detailText = this.querySelector<HTMLElement>('[data-diagram-detail-text]');
    this.motionBtn = this.querySelector<HTMLButtonElement>('[data-diagram-motion]');
    this.scrollArea = this.querySelector<HTMLElement>('[data-diagram-scroll-area]');
    this.viewport = this.querySelector<HTMLElement>('[data-diagram-viewport]');
    this.fallback = this.querySelector<HTMLDetailsElement>('.diagram-fallback');

    this.setupShadowDOM(host, svg);
    this.setupAccessibility();
    this.setupEventListeners(svg);
    this.setupMediaQuery();
    this.startLifecycle();

    if (this.fallback) this.fallback.hidden = true;
    if (this.motionBtn) this.motionBtn.hidden = false;
  }

  private setupShadowDOM(host: HTMLElement, svg: SVGSVGElement): void {
    const styleEl = svg.querySelector('style');
    let cssText = styleEl && styleEl.textContent ? styleEl.textContent : '';
    if (styleEl) styleEl.remove();

    cssText = cssText
      .replace(/"fonts"/g, '"diagram-fonts"')
      .replace(/"ink"/g, '"diagram-ink"');

    const serializeId = (id: string) => 'diagram-' + id;
    svg.querySelectorAll('[id]').forEach((el) => {
      const id = el.getAttribute('id');
      if (id) el.setAttribute('id', serializeId(id));
    });
    svg.querySelectorAll('*').forEach((el) => {
      Array.from(el.attributes).forEach((attr) => {
        if (attr.value.indexOf('url(#') !== -1) {
          attr.value = attr.value.replace(/url\(#([^)]+)\)/g, 'url(#diagram-$1)');
        }
      });
      const href = el.getAttribute('href') || el.getAttribute('xlink:href');
      if (href && href.charAt(0) === '#') {
        el.setAttribute('href', '#diagram-' + href.slice(1));
        if (el.hasAttribute('xlink:href')) el.setAttribute('xlink:href', '#diagram-' + href.slice(1));
      }
    });

    svg.removeAttribute('role');
    svg.removeAttribute('aria-labelledby');
    svg.setAttribute('role', 'group');
    svg.setAttribute('aria-label', 'Interactive architecture diagram. Activate nodes to explore connections.');

    const root = host.attachShadow({ mode: 'open' });
    const style = document.createElement('style');
    style.textContent = `
      :host { display: block; }
      svg { width: 100%; height: auto; max-width: 100%; display: block; }
      ${cssText}
      text { font-family: inherit; fill: #1a2733; }
      .node { cursor: pointer; outline: none; }
      .node:hover rect { stroke: #075973; }
      .node:focus-visible rect { stroke: #075973; stroke-width: 2.5; }
      .node.active rect {
        stroke-width: 3.5;
        filter: drop-shadow(0 3px 5px #254c6a55);
        stroke: #075973 !important;
        fill: #f0fbff !important;
      }
      .edge.active path { stroke: #075973; stroke-width: 3; }
    `;
    root.appendChild(style);
    root.appendChild(svg);

    this.nodes = Array.from(svg.querySelectorAll<SVGGElement>('.node'));
    this.edges = Array.from(svg.querySelectorAll<SVGGElement>('.edge'));
    this.pulses = Array.from(svg.querySelectorAll<SVGCircleElement>('.pulse'));
  }

  private setupAccessibility(): void {
    this.nodes.forEach((n) => {
      n.setAttribute('tabindex', '0');
      n.setAttribute('role', 'button');
      n.setAttribute('aria-pressed', 'false');
      const texts = n.querySelectorAll('text');
      const labelEl = texts[1];
      const labelText = labelEl && labelEl.textContent ? labelEl.textContent : n.id;
      n.setAttribute('aria-label', 'Select component: ' + labelText);
    });
  }

  private setupEventListeners(svg: SVGSVGElement): void {
    this.nodes.forEach((node) => {
      const originalId = node.id.replace(/^diagram-/, '');
      node.addEventListener('click', () => this.handleNodeSelect(originalId));
      node.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          this.handleNodeSelect(originalId);
        }
      });
    });

    if (this.motionBtn) {
      this.motionBtn.addEventListener('click', () => this.toggleMotion());
    }

    svg.addEventListener('keydown', this.boundKeydownHandler);
  }

  private handleKeydown(e: KeyboardEvent): void {
    if (e.key === 'Escape' && this.selectedId !== null) {
      e.preventDefault();
      this.clearSelection();
    }
  }

  private setupMediaQuery(): void {
    this.mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    this.motionEnabled = !this.mediaQuery.matches;
    this.updateMotionButton();
    this.mediaQuery.addEventListener('change', this.boundMotionChangeHandler);
  }

  private handleMotionPreferenceChange(e: MediaQueryListEvent): void {
    this.motionEnabled = !e.matches;
    this.updateMotionButton();
    if (!this.motionEnabled) this.stopAnimation();
    else if (this.shouldAnimate()) this.startAnimation();
  }

  private toggleMotion(): void {
    this.motionEnabled = !this.motionEnabled;
    this.updateMotionButton();
    if (!this.motionEnabled) {
      this.pulses.forEach((p) => p.setAttribute('opacity', '0'));
      this.stopAnimation();
    } else {
      this.startAnimation();
    }
  }

  private updateMotionButton(): void {
    if (!this.motionBtn) return;
    this.motionBtn.textContent = this.motionEnabled ? 'Pause motion' : 'Resume motion';
    this.motionBtn.setAttribute('aria-pressed', String(this.motionEnabled));
  }

  private startLifecycle(): void {
    document.addEventListener('visibilitychange', this.boundVisibilityHandler);
    this.setupIntersectionObserver();
    this.handleVisibilityChange();
  }

  private stopLifecycle(): void {
    document.removeEventListener('visibilitychange', this.boundVisibilityHandler);
    this.observers.forEach((o) => o.disconnect());
    this.observers = [];
    this.stopAnimation();
    if (this.mediaQuery) {
      this.mediaQuery.removeEventListener('change', this.boundMotionChangeHandler);
    }
  }

  private setupIntersectionObserver(): void {
    if (!this.viewport) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        this.inViewport = entry.isIntersecting;
        if (this.shouldAnimate()) {
          this.startAnimation();
        } else {
          this.stopAnimation();
        }
      });
    });
    observer.observe(this.viewport);
    this.observers.push(observer);
  }

  private handleVisibilityChange(): void {
    if (document.hidden) {
      this.stopAnimation();
    } else if (this.shouldAnimate()) {
      this.startAnimation();
    }
  }

  private shouldAnimate(): boolean {
    return this.motionEnabled && this.inViewport && this.isConnected && !document.hidden;
  }

  private startAnimation(): void {
    if (this.rafId !== null || !this.shouldAnimate()) return;
    const tick = (t: number) => {
      if (!this.shouldAnimate()) {
        this.rafId = null;
        return;
      }
      this.animatePulses(t / 1000);
      this.rafId = requestAnimationFrame(tick);
    };
    this.rafId = requestAnimationFrame(tick);
  }

  private stopAnimation(): void {
    this.pulses.forEach((p) => p.setAttribute('opacity', '0'));
    if (this.rafId !== null) {
      cancelAnimationFrame(this.rafId);
      this.rafId = null;
    }
  }

  private animatePulses(time: number): void {
    if (!this.svg) return;
    this.pulses.forEach((p, i) => {
      const pathId = p.getAttribute('data-path');
      if (!pathId) return;
      const path = this.svg!.querySelector<SVGPathElement>('#diagram-' + pathId);
      if (!path) return;

      const edge = p.closest('.edge');
      if (!edge) return;
      const edgeFrom = edge.getAttribute('data-from');
      const edgeTo = edge.getAttribute('data-to');
      const isSelected = this.selectedId !== null && (this.selectedId === edgeFrom || this.selectedId === edgeTo);

      if (this.selectedId !== null && !isSelected) {
        p.setAttribute('opacity', '0');
        return;
      }

      const progress = ((time / 5 + i / this.pulses.length) % 1 + 1) % 1;
      const point = path.getPointAtLength(path.getTotalLength() * progress);
      p.setAttribute('cx', String(point.x));
      p.setAttribute('cy', String(point.y));
      p.setAttribute('opacity', '0.9');
    });
  }

  private handleNodeSelect(id: string): void {
    if (this.selectedId === id) {
      this.clearSelection();

    } else {
      this.selectNode(id);

    }
  }

  private selectNode(id: string): void {
    this.selectedId = id;

    this.svg!.querySelectorAll<SVGGElement>('.node.active').forEach((n) => {
      n.classList.remove('active');
      n.setAttribute('aria-pressed', 'false');
    });
    this.edges.forEach((e) => e.classList.remove('active'));

    const node = this.svg!.querySelector<SVGGElement>('#diagram-' + CSS.escape(id));
    if (!node || !this.details[id]) return;

    node.classList.add('active');
    node.setAttribute('aria-pressed', 'true');
    this.edges.forEach((e) => {
      if (e.getAttribute('data-from') === id || e.getAttribute('data-to') === id) {
        e.classList.add('active');
      }
    });

    if (this.detailLabel) this.detailLabel.textContent = this.details[id].label;
    if (this.detailText) this.detailText.textContent = this.details[id].detail;
    if (this.detailArea) this.detailArea.classList.add('has-selection');

    this.panToNode(node);

    if (this.shouldAnimate() && this.rafId === null) {
      this.startAnimation();
    }
  }

  private clearSelection(): void {
    this.selectedId = null;
    this.svg!.querySelectorAll<SVGGElement>('.node.active').forEach((n) => {
      n.classList.remove('active');
      n.setAttribute('aria-pressed', 'false');
    });
    this.edges.forEach((e) => e.classList.remove('active'));

    if (this.detailArea) this.detailArea.classList.remove('has-selection');
    if (this.detailLabel) this.detailLabel.textContent = '';
    if (this.detailText) this.detailText.textContent = '';

    if (this.shouldAnimate() && this.rafId === null) {
      this.startAnimation();
    }
  }

  private panToNode(node: SVGGElement): void {
    if (!this.scrollArea || !this.viewport || !window.matchMedia('(max-width: 768px)').matches) return;
    try {
      const bbox = node.getBBox();
      const viewportRect = this.viewport.getBoundingClientRect();
      const nodeRect = node.getBoundingClientRect();
      if (bbox.width > 0) {
        const nodeCenter = nodeRect.left + nodeRect.width / 2;
        const currentFocal = viewportRect.left + this.scrollArea.clientWidth / 2;
        const delta = nodeCenter - currentFocal;
        this.scrollArea.scrollLeft = this.scrollArea.scrollLeft + delta;
      }
    } catch (e) {
      /* geometry unavailable */
    }
  }
}

if (!customElements.get('interactive-diagram')) {
  customElements.define('interactive-diagram', InteractiveDiagram);
}
</script>
