---
import { href, SITE_NAME, BASE } from '../lib/constants.mjs';

const mainLinks = [
  { label: 'Home', path: '/' },
  { label: 'Architecture', path: '/architecture/' },
  { label: 'Walkthroughs', path: '/walkthroughs/' },
  { label: 'Workflows', path: '/workflows/' },
  { label: 'Use cases', path: '/use-cases/' },
  { label: 'Founders', path: '/founders/' }
];

const path = (Astro.url.pathname.startsWith(BASE) ? '/' + Astro.url.pathname.slice(BASE.length) : Astro.url.pathname).replace(/\/$/, '') + '/';
---
<header class="site-header">
  <div class="shell nav-wrap">
    <a class="brand" href={href('/')} aria-label={SITE_NAME + ' home'}>
      <img src={href('/images/nora-mark.svg')} width="36" height="36" alt="" />
      <span>Nora <strong>SuperIntelligence Lab</strong></span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      {mainLinks.map(l => {
        const isCurrent = path === l.path || (l.path === '/use-cases/' && path.startsWith('/case-studies/'));
        return <a href={href(l.path)} aria-current={isCurrent ? 'page' : undefined}>{l.label}</a>;
      })}
    </nav>
    <a class="button button--small button--outline" href="https://github.com/lm2000/nora-ai-knowledge-agent-harness-public" target="_blank" rel="noreferrer">Public harness</a>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const updateHeight = () => document.documentElement.style.setProperty('--header-height', `${Math.ceil(header.getBoundingClientRect().height)}px`);
    updateHeight();
    new ResizeObserver(updateHeight).observe(header);
  }
</script>
