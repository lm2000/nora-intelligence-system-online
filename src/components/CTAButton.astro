---
import { href } from '../lib/constants.mjs';

interface Props {
  href?: string;
  label: string;
  variant?: 'primary' | 'outline';
  external?: boolean;
  icon?: string;
}

const { href: link = '#', label, variant = 'primary', external = false, icon } = Astro.props;
const resolvedHref = external ? link : href(link);
const iconSrc = icon === 'arrow' ? href('/images/icons/arrow-right.svg') : icon === 'external' ? href('/images/icons/external-link.svg') : null;
---
<a class={`cta cta-${variant}`} href={resolvedHref} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
  <span>{label}</span>
  {iconSrc && <img src={iconSrc} alt="" width="18" height="18" class="cta-icon" />}
</a>
<style>
.cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 24px;
  min-height: 48px;
  border-radius: 999px;
  font-weight: 600;
  font-size: 16px;
  text-decoration: none;
  border: 2px solid transparent;
  transition: background 0.15s ease, border-color 0.15s ease;
}
.cta-primary {
  background: var(--color-teal);
  color: #fff;
}
.cta-primary:hover {
  background: var(--color-teal-hover);
}
.cta-primary .cta-icon {
  filter: brightness(0) invert(1);
}
.cta-outline {
  background: transparent;
  color: var(--color-teal);
  border-color: var(--color-teal);
}
.cta-outline:hover {
  background: var(--color-cool);
}
.cta-icon { display: inline-block; }
</style>
