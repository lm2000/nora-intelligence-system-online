{
  "buildCommand": "pnpm validate",
  "outputDirectory": "dist",
  "framework": "astro",
  "installCommand": "pnpm install --frozen-lockfile",
  "redirects": [
    {
      "source": "/foundation",
      "destination": "/architecture/",
      "statusCode": 301
    },
    {
      "source": "/foundation/",
      "destination": "/architecture/",
      "statusCode": 301
    },
    {
      "source": "/foundation/index.html",
      "destination": "/architecture/",
      "statusCode": 301
    },
    {
      "source": "/foundation/operating-principles",
      "destination": "/decisions/",
      "statusCode": 301
    },
    {
      "source": "/foundation/operating-principles/",
      "destination": "/decisions/",
      "statusCode": 301
    },
    {
      "source": "/foundation/operating-principles/index.html",
      "destination": "/decisions/",
      "statusCode": 301
    },
    {
      "source": "/business-value",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/business-value/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/business-value/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/offerings/boutique-marketing-agency",
      "destination": "/archive/offerings/boutique-marketing-agency/index.html",
      "statusCode": 301
    },
    {
      "source": "/offerings/boutique-marketing-agency/",
      "destination": "/archive/offerings/boutique-marketing-agency/index.html",
      "statusCode": 301
    },
    {
      "source": "/offerings/boutique-marketing-agency/index.html",
      "destination": "/archive/offerings/boutique-marketing-agency/index.html",
      "statusCode": 301
    },
    {
      "source": "/offerings/career-interview-system",
