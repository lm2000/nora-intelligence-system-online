      "statusCode": 301
    },
    {
      "source": "/offerings/career-interview-system/",
      "destination": "/archive/offerings/career-interview-system/index.html",
      "statusCode": 301
    },
    {
      "source": "/offerings/career-interview-system/index.html",
      "destination": "/archive/offerings/career-interview-system/index.html",
      "statusCode": 301
    },
    {
      "source": "/offerings/boutique-marketing-agency/presentation.html",
